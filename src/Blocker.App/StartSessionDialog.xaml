<Window x:Class="Blocker.App.StartSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blocker.App"
        local:WindowHelper.UseThemeTitleBar="True"
        Title="Start Block"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource TextPrimary}">

    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="20">
        <StackPanel>
            <!-- Title -->
            <TextBlock x:Name="ProfileHeader" Text="Start Block" FontFamily="{DynamicResource FontTitle}"
                       FontWeight="SemiBold" FontSize="{DynamicResource FontSizeTitle}"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14" />

            <!-- Session Type Tabs -->
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="3" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="rbModeSprint" Grid.Column="0" IsChecked="True"
                                 GroupName="SessionType" Style="{StaticResource SegmentedTabButton}"
                                 Checked="SessionType_Changed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlay}" Width="12" Height="12"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Focus Sprint" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="rbModePomodoro" Grid.Column="1"
                                 GroupName="SessionType" Style="{StaticResource SegmentedTabButton}"
                                 Checked="SessionType_Changed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconTimer}" Width="12" Height="12"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Pomodoro Cycles" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </Border>

            <!-- SPRINT MODE PANEL -->
            <StackPanel x:Name="SprintPanel">
                <!-- Duration quick presets -->
                <TextBlock Text="QUICK PRESETS" FontWeight="Bold" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="1 hour" Style="{StaticResource SecondaryButton}" Click="QuickDuration_Click" Tag="1h" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                    <Button Grid.Column="2" Content="4 hours" Style="{StaticResource SecondaryButton}" Click="QuickDuration_Click" Tag="4h" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                    <Button Grid.Column="4" Content="1 day" Style="{StaticResource SecondaryButton}" Click="QuickDuration_Click" Tag="1d" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                    <Button Grid.Column="6" Content="3 days" Style="{StaticResource SecondaryButton}" Click="QuickDuration_Click" Tag="3d" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="1 week" Style="{StaticResource SecondaryButton}" Click="QuickDuration_Click" Tag="1w" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                    <Button Grid.Column="2" Content="1 month" Style="{StaticResource SecondaryButton}" Click="QuickDuration_Click" Tag="1m" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                    <Button Grid.Column="4" Content="3 months" Style="{StaticResource SecondaryButton}" Click="QuickDuration_Click" Tag="3m" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                    <Button Grid.Column="6" Content="1 year" Style="{StaticResource SecondaryButton}" Click="QuickDuration_Click" Tag="1y" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                </Grid>

                <!-- Custom duration -->
                <TextBlock Text="CUSTOM DURATION" FontWeight="Bold" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DurationInput" Text="1" Height="34" VerticalContentAlignment="Center"
                             Padding="10,5" FontSize="{DynamicResource FontSize13}"
                             Style="{StaticResource NumericInputTextBox}"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                    <ComboBox Grid.Column="2" x:Name="DurationUnitComboBox" SelectedIndex="2" Height="34" FontSize="{DynamicResource FontSize12}">
                        <ComboBoxItem Content="Minutes" />
                        <ComboBoxItem Content="Hours" />
                        <ComboBoxItem Content="Days" />
                        <ComboBoxItem Content="Weeks" />
                        <ComboBoxItem Content="Months (30d)" />
                        <ComboBoxItem Content="Years (365d)" />
                    </ComboBox>
                </Grid>
            </StackPanel>

            <!-- POMODORO MODE PANEL -->
            <StackPanel x:Name="PomodoroPanel" Visibility="Collapsed" Margin="0,0,0,16">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Focus Interval -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Focus Interval" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                        <TextBox x:Name="PomoFocusInput" Text="25" Style="{StaticResource NumericInputTextBox}" FontSize="{DynamicResource FontSize12}" />
                    </StackPanel>
                    <!-- Short Break -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Short Break" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                        <TextBox x:Name="PomoBreakInput" Text="5" Style="{StaticResource NumericInputTextBox}" FontSize="{DynamicResource FontSize12}" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Cycles -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Cycles" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                        <TextBox x:Name="PomoCyclesInput" Text="4" Style="{StaticResource NumericInputTextBox}" FontSize="{DynamicResource FontSize12}" />
                    </StackPanel>
                    <!-- Long Break -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Long Break" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                        <TextBox x:Name="PomoLongBreakInput" Text="15" Style="{StaticResource NumericInputTextBox}" FontSize="{DynamicResource FontSize12}" />
                    </StackPanel>
                </Grid>
                <!-- Reward Badge -->
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="{DynamicResource RadiusButton}" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconCheck}" Width="14" Height="14"
                              Stroke="{DynamicResource Success}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Rewards: Earns 10m break reward credit upon completing all 4 focus cycles."
                                   FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource Success}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Locked checkbox -->
            <CheckBox x:Name="LockedCheckBox" Content="Locked (cannot be stopped early)" IsChecked="True"
                      Margin="0,0,0,16" FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}" />

            <!-- Helpful Schedule Hint -->
            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource RadiusButton}"
                    Padding="10,6" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconInfo}" Width="14" Height="14"
                          Stroke="{DynamicResource TextSecondary}" Margin="0,2,6,0" VerticalAlignment="Top" />
                    <TextBlock Text="Tip: To set up recurring schedules (e.g. Mon-Fri 08:00-17:00), use the 'Edit' button on the block card."
                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Start Block" Click="StartButton_Click" Padding="18,8" MinWidth="100" Margin="0,0,8,0" />
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click" Padding="16,8" MinWidth="80" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
