<Window x:Class="Blocker.App.AppearanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blocker.App"
        local:WindowHelper.UseThemeTitleBar="True"
        Title="Appearance &amp; Personalization"
        Width="500" Height="520"
        MinWidth="440" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource FontBody}">

    <Window.Resources>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Window.Resources>

    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto" />
                <!-- Content -->
                <RowDefinition Height="*" />
                <!-- Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Appearance &amp; Theme" FontSize="{DynamicResource FontSizeHeading}" FontFamily="{DynamicResource FontTitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                <TextBlock Text="Customize your interface theme, accent color, and layout density."
                           FontSize="12" Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>

            <!-- Settings Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- THEME MODE SECTION -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="THEME MODE" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Dark Mode Option -->
                                <RadioButton x:Name="ThemeDarkRadio" Grid.Column="0" GroupName="ThemeGroup"
                                             Checked="ThemeRadio_Checked" Margin="0,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconMoon}" Fill="{DynamicResource TextPrimary}"
                                              Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock Text="Dark (Zinc/Slate)" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <!-- Light Mode Option -->
                                <RadioButton x:Name="ThemeLightRadio" Grid.Column="2" GroupName="ThemeGroup"
                                             Checked="ThemeRadio_Checked" Margin="0,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconSun}" Fill="{DynamicResource Warning}"
                                              Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock Text="Light (Crisp)" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ACCENT COLOR SECTION -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ACCENT COLOR" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" />

                            <!-- Color chips wrap panel -->
                            <WrapPanel Orientation="Horizontal">
                                <!-- Emerald (Default) -->
                                <RadioButton x:Name="AccentEmeraldRadio" GroupName="AccentGroup" Checked="AccentRadio_Checked"
                                             Tag="Emerald" Margin="0,0,12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" CornerRadius="{DynamicResource RadiusCard}" Background="#229B62" Margin="0,0,6,0" />
                                        <TextBlock Text="Emerald" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <!-- Indigo -->
                                <RadioButton x:Name="AccentIndigoRadio" GroupName="AccentGroup" Checked="AccentRadio_Checked"
                                             Tag="Indigo" Margin="0,0,12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" CornerRadius="{DynamicResource RadiusCard}" Background="#4F46E5" Margin="0,0,6,0" />
                                        <TextBlock Text="Indigo" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <!-- Violet -->
                                <RadioButton x:Name="AccentVioletRadio" GroupName="AccentGroup" Checked="AccentRadio_Checked"
                                             Tag="Violet" Margin="0,0,12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" CornerRadius="{DynamicResource RadiusCard}" Background="#7C3AED" Margin="0,0,6,0" />
                                        <TextBlock Text="Violet" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <!-- Amber -->
                                <RadioButton x:Name="AccentAmberRadio" GroupName="AccentGroup" Checked="AccentRadio_Checked"
                                             Tag="Amber" Margin="0,0,12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" CornerRadius="{DynamicResource RadiusCard}" Background="#D97706" Margin="0,0,6,0" />
                                        <TextBlock Text="Amber" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <!-- Rose -->
                                <RadioButton x:Name="AccentRoseRadio" GroupName="AccentGroup" Checked="AccentRadio_Checked"
                                             Tag="Rose" Margin="0,0,12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" CornerRadius="{DynamicResource RadiusCard}" Background="#BE185D" Margin="0,0,6,0" />
                                        <TextBlock Text="Rose" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <!-- Slate -->
                                <RadioButton x:Name="AccentSlateRadio" GroupName="AccentGroup" Checked="AccentRadio_Checked"
                                             Tag="Slate" Margin="0,0,12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" CornerRadius="{DynamicResource RadiusCard}" Background="#475569" Margin="0,0,6,0" />
                                        <TextBlock Text="Slate" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- KEYBOARD SHORTCUTS SECTION -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Clickable Header -->
                            <Button x:Name="ShortcutsToggleButton" Click="ToggleShortcuts_Click"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="KEYBOARD SHORTCUTS" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1" CornerRadius="{DynamicResource RadiusButton}" Padding="8,4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="ShortcutsToggleTextBlock" Text="Expand shortcuts" FontSize="{DynamicResource FontSize12}"
                                                       Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <Path x:Name="ShortcutsChevronPath" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"
                                                  Fill="{DynamicResource Accent}" Data="{DynamicResource IconChevronDown}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Button>

                            <StackPanel x:Name="ShortcutsContainer" Visibility="Collapsed" Margin="0,12,0,0">
                                <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,10" />

                                <!-- Ctrl + B -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="New Block Profile" FontSize="{DynamicResource FontSize13}"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Ctrl + B" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,10" />

                            <!-- Ctrl + S -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Open Settings" FontSize="{DynamicResource FontSize13}"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Ctrl + S" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,10" />

                            <!-- Ctrl + M -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Meditation Mode" FontSize="{DynamicResource FontSize13}"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Ctrl + M" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,10" />

                            <!-- Alt + N -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Quick Notes Overlay" FontSize="{DynamicResource FontSize13}"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Alt + N" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD DENSITY SECTION -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="CARD DENSITY" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="DensityComfortableRadio" GroupName="DensityGroup"
                                             Checked="DensityRadio_Checked" Content="Comfortable (Spacious)" Margin="0,0,24,0" />
                                <RadioButton x:Name="DensityCompactRadio" GroupName="DensityGroup"
                                             Checked="DensityRadio_Checked" Content="Compact (High density)" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- MEDITATION & LOCKDOWN SAFETY SECTION -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="MEDITATION &amp; LOCKDOWN" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Show warning before starting Meditation &amp; Lockdown"
                                               FontSize="{DynamicResource FontSize13}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="Displays confirmation dialog with session details and lockout warning"
                                               FontSize="{DynamicResource FontSize12}"
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="MeditationWarningToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding ShowMeditationStartWarning, Mode=TwoWay}"
                                          Click="MeditationWarningToggle_Click"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Button Content="Done" Click="Done_Click" HorizontalAlignment="Right"
                        Padding="24,7" FontWeight="SemiBold" />
            </Grid>
        </Grid>
    </Border>
</Window>
