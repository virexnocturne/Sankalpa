<Window x:Class="Blocker.App.ZenQuickNotesOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Notes"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Width="420"
        Height="540"
        MinWidth="340"
        MinHeight="380"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource FontBody}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="OverlayIconButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceRaised}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayMiniButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize12}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BorderStrong}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource Surface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer margin so drop shadow is not clipped by window boundary -->
    <Border CornerRadius="12"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.65" Direction="270" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Draggable Header Bar -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Content Area (Cards List or Composer) -->
                <RowDefinition Height="*" />
                <!-- Row 2: Status / Footer Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Draggable Header Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    Padding="14,10"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Title & Lotus Icon -->
                        <ColumnDefinition Width="*" />
                        <!-- Action buttons -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{StaticResource Icon}"
                              Data="{StaticResource IconLotus}"
                              Width="18" Height="18"
                              Stroke="{DynamicResource Accent}"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0" />
                        <TextBlock Text="Quick Notes"
                                   FontFamily="{DynamicResource FontTitle}"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource FontSize14}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- + New Note Button -->
                        <Button x:Name="NewNoteButton"
                                Content="+ New Note"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,4"
                                FontSize="{DynamicResource FontSize12}"
                                FontWeight="SemiBold"
                                Click="NewNoteButton_Click"
                                Margin="0,0,8,0"
                                ToolTip="Create a new quick note or task list" />

                        <!-- Close Button -->
                        <Button x:Name="CloseButton"
                                Style="{StaticResource OverlayIconButton}"
                                Click="CloseButton_Click"
                                Width="26" Height="26"
                                ToolTip="Close Notes Overlay (Esc / Alt+N)">
                            <Path Style="{StaticResource Icon}"
                                  Data="{StaticResource IconX}"
                                  Width="12" Height="12"
                                  Stroke="{DynamicResource TextSecondary}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: Body Area -->
            <Grid Grid.Row="1" Margin="14,12,14,8">
                <!-- VIEW 1: Cards List & Empty State -->
                <Grid x:Name="CardsViewPanel" Visibility="Visible">
                    <!-- Empty State (when 0 cards) -->
                    <StackPanel x:Name="EmptyStatePanel"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="20"
                                Visibility="Collapsed">
                        <Path Style="{StaticResource Icon}"
                              Data="{StaticResource IconLotus}"
                              Width="36" Height="36"
                              Stroke="{DynamicResource TextDisabled}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,12" />
                        <TextBlock Text="No quick notes yet"
                                   FontFamily="{DynamicResource FontTitle}"
                                   FontSize="{DynamicResource FontSize15}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Capture ideas, tasks, or contemplation insights while in focus mode."
                                   FontSize="{DynamicResource FontSize12}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="260"
                                   Margin="0,0,0,16" />
                        <Button Content="+ Create First Note"
                                Style="{StaticResource PrimaryButton}"
                                Padding="16,6"
                                FontSize="{DynamicResource FontSize12}"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                Click="NewNoteButton_Click" />
                    </StackPanel>

                    <!-- Scrollable Cards Container -->
                    <ScrollViewer x:Name="CardsScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CardsItemsPanel" />
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 2: Note Composer -->
                <Grid x:Name="ComposerPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Composer Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Title Input -->
                        <RowDefinition Height="Auto" />
                        <!-- Content Area (Edit or Live Preview) -->
                        <RowDefinition Height="*" />
                        <!-- Composer Actions Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Composer Header: Title on Left, Edit / Preview Toggle on Right -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ComposerHeadingText"
                                   Grid.Column="0"
                                   Text="New Quick Note"
                                   FontFamily="{DynamicResource FontTitle}"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource FontSize14}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" />

                        <!-- Edit / Preview Segmented Tab Toggle -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource SurfaceRaised}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ComposerEditTabBtn"
                                        Content="Edit"
                                        Style="{StaticResource OverlayMiniButton}"
                                        Padding="8,2"
                                        Click="ComposerEditTab_Click"
                                        ToolTip="Write Markdown"
                                        Margin="0,0,2,0" />
                                <Button x:Name="ComposerPreviewTabBtn"
                                        Content="Preview"
                                        Style="{StaticResource OverlayMiniButton}"
                                        Padding="8,2"
                                        Click="ComposerPreviewTab_Click"
                                        ToolTip="Live Markdown Preview (Ctrl+P)" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 1: Title Input -->
                    <TextBox x:Name="ComposerTitleInput"
                             Grid.Row="1"
                             Background="{DynamicResource SurfaceRaised}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource Border}"
                             BorderThickness="1"
                             FontSize="{DynamicResource FontSize13}"
                             Padding="8,5"
                             Margin="0,0,0,8"
                             CaretBrush="{DynamicResource Accent}"
                             ToolTip="Note title (optional, auto-detected from # heading)" />

                    <!-- Row 2: Content Area (Edit TextBox or Live Preview) -->
                    <Grid Grid.Row="2">
                        <!-- Content Text Area (Edit Mode) with Right-Click Context Menu and Image Previews -->
                        <Grid x:Name="ComposerEditArea">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBox x:Name="ComposerContentInput"
                                     Grid.Row="0"
                                     Background="{DynamicResource SurfaceRaised}"
                                     Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource Border}"
                                     BorderThickness="1"
                                     FontFamily="{DynamicResource FontMono}"
                                     FontSize="{DynamicResource FontSize13}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Padding="10,8"
                                     CaretBrush="{DynamicResource Accent}"
                                     KeyDown="ComposerContentInput_KeyDown">
                                <TextBox.ContextMenu>
                                    <ContextMenu Background="{DynamicResource SurfaceRaised}"
                                                 BorderBrush="{DynamicResource BorderStrong}"
                                                 BorderThickness="1"
                                                 Foreground="{DynamicResource TextPrimary}">
                                        <MenuItem Header="Insert Task (- [ ])" Click="InsertTask_Click" InputGestureText="Ctrl+Shift+T" />
                                        <MenuItem Header="Insert Bullet (- )" Click="InsertBullet_Click" />
                                        <MenuItem Header="Insert Numbered List (1. )" Click="InsertNumbered_Click" />
                                        <Separator Background="{DynamicResource Border}" />
                                        <MenuItem Header="Heading 1 (# )" Click="InsertH1_Click" />
                                        <MenuItem Header="Heading 2 (## )" Click="InsertH2_Click" />
                                        <MenuItem Header="Heading 3 (### )" Click="InsertH3_Click" />
                                        <Separator Background="{DynamicResource Border}" />
                                        <MenuItem Header="Format Bold (**bold**)" Click="InsertBold_Click" InputGestureText="Ctrl+B" />
                                        <MenuItem Header="Format Italic (*italic*)" Click="InsertItalic_Click" InputGestureText="Ctrl+I" />
                                        <MenuItem Header="Format Strikethrough (~~text~~)" Click="InsertStrikethrough_Click" />
                                        <MenuItem Header="Format Highlight (==text==)" Click="InsertHighlight_Click" />
                                        <MenuItem Header="Format Inline Code (`code`)" Click="InsertCode_Click" />
                                        <MenuItem Header="Insert Quote (&gt; )" Click="InsertQuote_Click" />
                                        <Separator Background="{DynamicResource Border}" />
                                        <MenuItem Command="Cut" Header="Cut" />
                                        <MenuItem Command="Copy" Header="Copy" />
                                        <MenuItem Command="Paste" Header="Paste" />
                                        <MenuItem Command="SelectAll" Header="Select All" />
                                    </ContextMenu>
                                </TextBox.ContextMenu>
                            </TextBox>

                            <!-- In-Edit-Mode Screenshot Previews Strip -->
                            <Border x:Name="EditModeImagePreviewStrip"
                                    Grid.Row="1"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource SurfaceRaised}"
                                    BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,6,0,0"
                                    Padding="6,4">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="EditModeImageThumbnailsPanel" Orientation="Horizontal" />
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- Live Preview Area (Preview Mode) -->
                        <Border x:Name="ComposerPreviewContainer"
                                Visibility="Collapsed"
                                Background="{DynamicResource SurfaceRaised}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ComposerPreviewPanel" />
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Row 3: Composer Buttons -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Ctrl+Enter save • Right-click presets"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource FontSize12}"
                                   Foreground="{DynamicResource TextDisabled}"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Cancel"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="14,5"
                                    FontSize="{DynamicResource FontSize12}"
                                    Click="CancelComposer_Click"
                                    Margin="0,0,8,0" />
                            <Button Content="Save Note"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,5"
                                    FontSize="{DynamicResource FontSize12}"
                                    FontWeight="SemiBold"
                                    Click="SaveComposer_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Row 2: Status / Footer Bar -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,1,0,0"
                    Padding="14,8"
                    Background="{DynamicResource Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Auto-save state -->
                        <ColumnDefinition Width="*" />
                        <!-- Keyboard badge -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="AutoSaveIcon"
                              Style="{StaticResource Icon}"
                              Data="{StaticResource IconCheck}"
                              Width="12" Height="12"
                              Stroke="{DynamicResource Success}"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center" />
                        <TextBlock x:Name="AutoSaveStatusText"
                                   Text="Auto-saved"
                                   FontSize="{DynamicResource FontSize12}"
                                   Foreground="{DynamicResource Success}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            x:Name="QuickNotesToggleHintBadge"
                            Background="{DynamicResource SurfaceRaised}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="Alt + N to toggle"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="{DynamicResource FontSize12}"
                                   Foreground="{DynamicResource TextDisabled}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
