<UserControl x:Class="Blocker.App.NotesDrawerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Blocker.App">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <local:AttachmentImageConverter x:Key="AttachmentImageConverter" />

        <sys:Double x:Key="HeaderFontSize">15</sys:Double>
        <sys:Double x:Key="SubheaderFontSize">13.5</sys:Double>

        <Style x:Key="DrawerMiniButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize12}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BorderStrong}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource Surface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DrawerTabButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1,1,0,1" />
            <Setter Property="Padding" Value="6,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6,0,0,6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Surface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardHeaderButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
        <!-- ======================================================== -->
        <!-- PINNED RIGHT-EDGE SLIDE-OUT TAB HANDLE ("NOTES")         -->
        <!-- ======================================================== -->
        <Button x:Name="DrawerTabButton"
                Click="DrawerTabButton_Click"
                Style="{StaticResource DrawerTabButtonStyle}"
                VerticalAlignment="Center"
                ToolTip="Toggle Notes Drawer">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Chevron Arrow -->
                <Path x:Name="TabChevronPath"
                      Style="{StaticResource Icon}"
                      Data="{StaticResource IconChevronLeft}"
                      Width="10" Height="10"
                      Stroke="{DynamicResource Accent}"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,8" />

                <!-- Rotated Word "NOTES" (-90deg counter-clockwise, S at top, N at bottom) -->
                <TextBlock Text="NOTES"
                           FontFamily="{DynamicResource FontTitle}"
                           FontSize="{DynamicResource FontSize12}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </StackPanel>
        </Button>

        <!-- ======================================================== -->
        <!-- SLIDE-OUT NOTES DRAWER PANEL (340px)                     -->
        <!-- ======================================================== -->
        <Border x:Name="DrawerContainer"
                Width="0"
                Visibility="Collapsed"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1,0,0,0"
                VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Drawer Header & Status -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 1: Drawer Body (Cards / Empty / Composer) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- DRAWER HEADER -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,0,0,1"
                        Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Title and Auto-save -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Notes"
                                       FontFamily="{DynamicResource FontTitle}"
                                       FontSize="{DynamicResource FontSizeHeading}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding AutoSaveStatus}"
                                       FontSize="{DynamicResource FontSize12}"
                                       Foreground="{DynamicResource Success}"
                                       Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Close Drawer Button -->
                        <Button Grid.Column="1"
                                Click="CloseDrawerButton_Click"
                                Style="{StaticResource IconButton}"
                                Width="26" Height="26"
                                VerticalAlignment="Center"
                                ToolTip="Close Notes Drawer">
                            <Path Style="{StaticResource Icon}"
                                  Data="{StaticResource IconX}"
                                  Width="12" Height="12"
                                  Stroke="{DynamicResource TextSecondary}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- DRAWER BODY -->
                <Grid Grid.Row="1" Margin="16,14">

                    <!-- ==================================================== -->
                    <!-- 1. EMPTY STATE                                        -->
                    <!-- ==================================================== -->
                    <Grid Visibility="{Binding HasNoNotes, Converter={StaticResource BoolToVis}}">
                        <StackPanel Visibility="{Binding IsComposerClosed, Converter={StaticResource BoolToVis}}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,20">
                            <!-- Illustration Icon -->
                            <Path Style="{StaticResource Icon}"
                                  Data="{StaticResource IconFileText}"
                                  Width="38" Height="38"
                                  Stroke="{DynamicResource TextDisabled}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,14" />

                            <TextBlock Text="No notes yet"
                                       FontFamily="{DynamicResource FontTitle}"
                                       FontSize="{DynamicResource FontSizeHeading}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6" />

                            <TextBlock Text="Reflect on intentions, insights, or tasks during focus."
                                       FontSize="{DynamicResource FontSize12}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,20" />

                            <Button Content="+ New Note"
                                    Command="{Binding NewNoteCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="18,8"
                                    FontSize="{DynamicResource FontSize12}"
                                    HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- ==================================================== -->
                    <!-- 2. CARDS LIST WITH ACCORDION                          -->
                    <!-- ==================================================== -->
                    <Grid Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                        <Grid Visibility="{Binding IsComposerClosed, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <!-- Top Bar with Note Count and New Note Button -->
                                <RowDefinition Height="Auto" />
                                <!-- Scrollable Cards -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Top Bar -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="{Binding NotesCountText}"
                                           FontSize="{DynamicResource FontSize12}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" />

                                <Button Content="+ New Note"
                                        Command="{Binding NewNoteCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,5"
                                        FontSize="{DynamicResource FontSize12}"
                                        HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Cards List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding NotesCollection}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Card Container -->
                                            <Border CornerRadius="{DynamicResource RadiusCard}"
                                                    Background="{DynamicResource SurfaceRaised}"
                                                    BorderBrush="{DynamicResource Border}"
                                                    BorderThickness="1"
                                                    Margin="0,0,0,8"
                                                    Padding="12">
                                                <StackPanel>
                                                    <!-- Card Header -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Clickable Header (Toggles Accordion) -->
                                                        <Button Grid.Column="0"
                                                                Command="{Binding DataContext.ToggleCardExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource CardHeaderButtonStyle}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontWeight="Bold"
                                                                           FontSize="{DynamicResource FontSize13}"
                                                                           Foreground="{DynamicResource TextPrimary}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding RelativeTime}"
                                                                           FontSize="{DynamicResource FontSize12}"
                                                                           Foreground="{DynamicResource TextDisabled}"
                                                                           Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Action Buttons: Pencil (Edit) & Trash (Delete) -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                            <!-- Edit Button -->
                                                            <Button Command="{Binding DataContext.EditNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource IconButton}"
                                                                    Width="24" Height="24"
                                                                    Padding="3"
                                                                    Margin="0,0,4,0"
                                                                    ToolTip="Edit Note">
                                                                <Path Style="{StaticResource Icon}"
                                                                      Data="{StaticResource IconPencil}"
                                                                      Width="12" Height="12"
                                                                      Stroke="{DynamicResource TextSecondary}" />
                                                            </Button>

                                                            <!-- Delete Button -->
                                                            <Button Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource IconButton}"
                                                                    Width="24" Height="24"
                                                                    Padding="3"
                                                                    ToolTip="Delete Note">
                                                                <Path Style="{StaticResource Icon}"
                                                                      Data="{StaticResource IconTrash}"
                                                                      Width="12" Height="12"
                                                                      Stroke="{DynamicResource Danger}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Accordion Body (Rendered Markdown) -->
                                                    <Border Margin="0,10,0,0"
                                                            Padding="0,8,0,0"
                                                            BorderBrush="{DynamicResource Border}"
                                                            BorderThickness="0,1,0,0"
                                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel>
                                                            <!-- Parsed Markdown Blocks -->
                                                            <ItemsControl ItemsSource="{Binding VisibleBlocks}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,2">
                                                                            <!-- Header Block -->
                                                                            <TextBlock Text="{Binding Text}"
                                                                                       FontWeight="Bold"
                                                                                       FontSize="{DynamicResource HeaderFontSize}"
                                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                                       Margin="0,5,0,2"
                                                                                       TextWrapping="Wrap">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding BlockType}" Value="Header">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>

                                                                            <!-- Subheader Block -->
                                                                            <TextBlock Text="{Binding Text}"
                                                                                       FontWeight="SemiBold"
                                                                                       FontSize="{DynamicResource SubheaderFontSize}"
                                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                                       Margin="0,3,0,1"
                                                                                       TextWrapping="Wrap">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding BlockType}" Value="Subheader">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>

                                                                            <!-- BulletItem Block -->
                                                                            <DockPanel Margin="0,2">
                                                                                <DockPanel.Style>
                                                                                    <Style TargetType="DockPanel">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding BlockType}" Value="BulletItem">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </DockPanel.Style>
                                                                                <TextBlock Text="• "
                                                                                           FontWeight="Bold"
                                                                                           Foreground="{DynamicResource Accent}"
                                                                                           FontSize="{DynamicResource FontSize12}"
                                                                                           DockPanel.Dock="Left"
                                                                                           VerticalAlignment="Top" />
                                                                                <TextBlock Text="{Binding Text}"
                                                                                           FontSize="{DynamicResource FontSize12}"
                                                                                           Foreground="{DynamicResource TextSecondary}"
                                                                                           TextWrapping="Wrap"
                                                                                           VerticalAlignment="Center" />
                                                                            </DockPanel>

                                                                            <!-- Interactive Task Checkbox Block -->
                                                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                                      Margin="0,2"
                                                                                      Cursor="Hand">
                                                                                <CheckBox.Style>
                                                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding BlockType}" Value="TaskItem">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </CheckBox.Style>
                                                                                <TextBlock Text="{Binding Text}"
                                                                                           FontSize="{DynamicResource FontSize12}"
                                                                                           Foreground="{DynamicResource TextSecondary}"
                                                                                           TextWrapping="Wrap"
                                                                                           VerticalAlignment="Center">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </CheckBox>

                                                                            <!-- Paragraph Block -->
                                                                            <TextBlock Text="{Binding Text}"
                                                                                       FontSize="{DynamicResource FontSize12}"
                                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                                       TextWrapping="Wrap"
                                                                                       Margin="0,1">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding BlockType}" Value="Paragraph">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>

                                                                            <!-- Image Block -->
                                                                            <Border CornerRadius="6"
                                                                                    BorderBrush="{DynamicResource Border}"
                                                                                    BorderThickness="1"
                                                                                    Background="{DynamicResource SurfaceRaised}"
                                                                                    Padding="2"
                                                                                    Margin="0,4,0,4"
                                                                                    HorizontalAlignment="Left">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding BlockType}" Value="Image">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <Image Source="{Binding ImagePath, Converter={StaticResource AttachmentImageConverter}}"
                                                                                       MaxHeight="180"
                                                                                       Stretch="Uniform" />
                                                                            </Border>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- See More / See Less Button -->
                                                            <Button Content="{Binding SeeMoreText}"
                                                                    Command="{Binding DataContext.ToggleSeeMoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding ShowSeeMore, Converter={StaticResource BoolToVis}}"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Foreground="{DynamicResource Accent}"
                                                                    FontSize="{DynamicResource FontSize12}"
                                                                    Cursor="Hand"
                                                                    Padding="0,4,0,0"
                                                                    HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ==================================================== -->
                    <!-- 3. NOTE COMPOSER VIEW                                 -->
                    <!-- ==================================================== -->
                    <Border Visibility="{Binding IsComposerOpen, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Composer Header: Title on Left, Edit / Preview Toggle on Right -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding ComposerHeadingText}"
                                           FontFamily="{DynamicResource FontTitle}"
                                           FontSize="{DynamicResource FontSizeHeading}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center" />

                                <!-- Edit / Preview Segmented Tab Toggle -->
                                <Border Grid.Column="1"
                                        Background="{DynamicResource SurfaceRaised}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="2"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ComposerSnipBtn"
                                                Content="Snip"
                                                Style="{StaticResource DrawerMiniButton}"
                                                Padding="8,2"
                                                Click="ComposerSnip_Click"
                                                ToolTip="Take Screenshot (Ctrl+Shift+S)"
                                                Margin="0,0,2,0" />
                                        <Button x:Name="ComposerEditTabBtn"
                                                Content="Edit"
                                                Style="{StaticResource DrawerMiniButton}"
                                                Padding="8,2"
                                                Click="ComposerEditTab_Click"
                                                ToolTip="Write Markdown"
                                                Margin="0,0,2,0" />
                                        <Button x:Name="ComposerPreviewTabBtn"
                                                Content="Preview"
                                                Style="{StaticResource DrawerMiniButton}"
                                                Padding="8,2"
                                                Click="ComposerPreviewTab_Click"
                                                ToolTip="Live Markdown Preview (Ctrl+P)" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Composer Input Fields -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Title Input Field -->
                                    <TextBlock Text="Title"
                                               FontSize="{DynamicResource FontSize12}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,0,4" />

                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="Note title / heading..."
                                                   FontSize="{DynamicResource FontSize13}"
                                                   Foreground="{DynamicResource TextDisabled}"
                                                   VerticalAlignment="Top"
                                                   Margin="10,8,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TitleBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBox x:Name="TitleBox"
                                                 Text="{Binding ComposerTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{DynamicResource Bg}"
                                                 BorderBrush="{DynamicResource Border}"
                                                 BorderThickness="1"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 FontSize="{DynamicResource FontSize13}"
                                                 Padding="8,6"
                                                 VerticalContentAlignment="Top"
                                                 VerticalAlignment="Top" />
                                    </Grid>

                                    <!-- Markdown Body Input Field -->
                                    <TextBlock Text="Markdown Content"
                                               FontSize="{DynamicResource FontSize12}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,0,4" />

                                    <Grid>
                                        <!-- Edit Mode Area (TextBox & In-Edit Screenshot Previews) -->
                                        <Grid x:Name="ComposerEditArea">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Watermark Placeholder and MarkdownBox in Row 0 -->
                                            <Grid Grid.Row="0">
                                                <TextBlock Text="Write markdown (# heading, - [ ] task, reflections)..."
                                                           FontSize="{DynamicResource FontSize13}"
                                                           FontFamily="{DynamicResource FontMono}"
                                                           Foreground="{DynamicResource TextDisabled}"
                                                           VerticalAlignment="Top"
                                                           Margin="10,8,0,0"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=MarkdownBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBox x:Name="MarkdownBox"
                                                         Background="{DynamicResource Bg}"
                                                         BorderBrush="{DynamicResource Border}"
                                                         BorderThickness="1"
                                                         Foreground="{DynamicResource TextPrimary}"
                                                         FontFamily="{DynamicResource FontMono}"
                                                         FontSize="{DynamicResource FontSize13}"
                                                         Padding="8,8"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         MinHeight="180"
                                                         MaxHeight="360"
                                                         VerticalScrollBarVisibility="Auto"
                                                         VerticalContentAlignment="Top"
                                                         VerticalAlignment="Top"
                                                         CaretBrush="{DynamicResource Accent}">
                                                    <TextBox.ContextMenu>
                                                        <ContextMenu Background="{DynamicResource SurfaceRaised}"
                                                                     BorderBrush="{DynamicResource BorderStrong}"
                                                                     BorderThickness="1"
                                                                     Foreground="{DynamicResource TextPrimary}">
                                                            <MenuItem Header="Insert Task (- [ ])" Click="InsertTask_Click" InputGestureText="Ctrl+Shift+T" />
                                                            <MenuItem Header="Insert Bullet (- )" Click="InsertBullet_Click" />
                                                            <MenuItem Header="Insert Numbered List (1. )" Click="InsertNumbered_Click" />
                                                            <Separator Background="{DynamicResource Border}" />
                                                            <MenuItem Header="Heading 1 (# )" Click="InsertH1_Click" />
                                                            <MenuItem Header="Heading 2 (## )" Click="InsertH2_Click" />
                                                            <MenuItem Header="Heading 3 (### )" Click="InsertH3_Click" />
                                                            <Separator Background="{DynamicResource Border}" />
                                                            <MenuItem Header="Format Bold (**bold**)" Click="InsertBold_Click" InputGestureText="Ctrl+B" />
                                                            <MenuItem Header="Format Italic (*italic*)" Click="InsertItalic_Click" InputGestureText="Ctrl+I" />
                                                            <MenuItem Header="Format Strikethrough (~~text~~)" Click="InsertStrikethrough_Click" />
                                                            <MenuItem Header="Format Highlight (==text==)" Click="InsertHighlight_Click" />
                                                            <MenuItem Header="Format Inline Code (`code`)" Click="InsertCode_Click" />
                                                            <MenuItem Header="Insert Quote (&gt; )" Click="InsertQuote_Click" />
                                                            <Separator Background="{DynamicResource Border}" />
                                                            <MenuItem Command="Cut" Header="Cut" />
                                                            <MenuItem Command="Copy" Header="Copy" />
                                                            <MenuItem Command="Paste" Header="Paste" />
                                                            <MenuItem Command="SelectAll" Header="Select All" />
                                                        </ContextMenu>
                                                    </TextBox.ContextMenu>
                                                </TextBox>
                                            </Grid>

                                            <!-- In-Edit-Mode Screenshot Previews Strip in Row 1 -->
                                            <Border x:Name="EditModeImagePreviewStrip"
                                                    Grid.Row="1"
                                                    Visibility="Collapsed"
                                                    Background="{DynamicResource SurfaceRaised}"
                                                    BorderBrush="{DynamicResource Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Margin="0,6,0,0"
                                                    Padding="6,4">
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                    <StackPanel x:Name="EditModeImageThumbnailsPanel" Orientation="Horizontal" />
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>

                                        <!-- Live Preview Area (Preview Mode) -->
                                        <Border x:Name="ComposerPreviewContainer"
                                                Visibility="Collapsed"
                                                Background="{DynamicResource SurfaceRaised}"
                                                BorderBrush="{DynamicResource Border}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="12,10"
                                                MinHeight="180"
                                                MaxHeight="360">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel x:Name="ComposerPreviewPanel" />
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Actions Row: Emerald [ Save Note ] and [ Cancel ] -->
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,14,0,0">
                                <Button Content="Save Note"
                                        Command="{Binding SaveNoteCardCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="16,7"
                                        FontSize="{DynamicResource FontSize12}" />

                                <Button Content="Cancel"
                                        Command="{Binding CancelNoteComposerCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="14,7"
                                        FontSize="{DynamicResource FontSize12}"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
