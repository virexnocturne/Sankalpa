<Window x:Class="Blocker.App.ZenSnipOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sankalpa Zen Snip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    
    <Grid x:Name="RootGrid" Background="Transparent" Cursor="Cross"
          MouseLeftButtonDown="RootGrid_MouseLeftButtonDown"
          MouseMove="RootGrid_MouseMove"
          MouseLeftButtonUp="RootGrid_MouseLeftButtonUp">
        
        <!-- Frozen Screen Background Image -->
        <Image x:Name="BackgroundImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />

        <!-- Dimming Mask with Cutout -->
        <Path x:Name="MaskPath" Fill="{DynamicResource Bg}" Opacity="0.55" />

        <!-- Selection Rubberband Border -->
        <Canvas x:Name="OverlayCanvas">
            <Border x:Name="SelectionBorder"
                    BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1.5"
                    Background="Transparent"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{DynamicResource ColorAccent}" Opacity="0.6" />
                </Border.Effect>
            </Border>

            <!-- Floating Dimensions & Tip Badge -->
            <Border x:Name="InfoBadge"
                    Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,5"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="DimensionText"
                               Text="0 × 0"
                               FontFamily="{DynamicResource FontMono}"
                               FontSize="{DynamicResource FontSize12}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Accent}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="• Drag to crop | Esc to cancel | Enter for fullscreen"
                               FontFamily="{DynamicResource FontBody}"
                               FontSize="{DynamicResource FontSize12}"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
