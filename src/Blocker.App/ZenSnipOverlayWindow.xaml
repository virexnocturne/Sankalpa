<Window x:Class="Blocker.App.ZenSnipOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sankalpa Zen Snip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    
    <Grid x:Name="RootGrid" Background="Transparent" Cursor="Cross"
          PreviewMouseLeftButtonDown="RootGrid_PreviewMouseLeftButtonDown"
          PreviewMouseMove="RootGrid_PreviewMouseMove"
          PreviewMouseLeftButtonUp="RootGrid_PreviewMouseLeftButtonUp"
          LostMouseCapture="RootGrid_LostMouseCapture">
        
        <!-- Frozen Screen Background Image: mapped 1:1 with screen DIP dimensions (Zero Zoom) -->
        <Image x:Name="BackgroundImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />

        <!-- Dimming Mask Rectangles (4-slice overlay: buttery smooth, zero geometry tessellation) -->
        <Canvas x:Name="MaskCanvas" IsHitTestVisible="False">
            <Border x:Name="MaskTop" Background="{DynamicResource Bg}" Opacity="0.55" IsHitTestVisible="False" />
            <Border x:Name="MaskBottom" Background="{DynamicResource Bg}" Opacity="0.55" IsHitTestVisible="False" />
            <Border x:Name="MaskLeft" Background="{DynamicResource Bg}" Opacity="0.55" IsHitTestVisible="False" />
            <Border x:Name="MaskRight" Background="{DynamicResource Bg}" Opacity="0.55" IsHitTestVisible="False" />
        </Canvas>

        <!-- Selection Rubberband Border -->
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
            <Border x:Name="SelectionBorder"
                    BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1.5"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{DynamicResource ColorAccent}" Opacity="0.6" />
                </Border.Effect>
            </Border>

            <!-- Floating Dimensions & Tip Badge -->
            <Border x:Name="InfoBadge"
                    Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,5"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                    <TextBlock x:Name="DimensionText"
                               Text="0 × 0"
                               FontFamily="{DynamicResource FontMono}"
                               FontSize="{DynamicResource FontSize12}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Accent}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="• Drag to crop | Esc to cancel | Enter for fullscreen"
                               FontFamily="{DynamicResource FontBody}"
                               FontSize="{DynamicResource FontSize12}"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
