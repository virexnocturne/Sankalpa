<Window x:Class="Blocker.App.TypingChallengeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blocker.App"
        local:WindowHelper.UseThemeTitleBar="True"
        Title="Typing Challenge Unlock"
        Width="600" Height="400"
        MinWidth="520" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource TextPrimary}">

    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Text="Type to Unlock" FontFamily="{DynamicResource FontTitle}"
                       FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />

            <!-- Prompt -->
            <TextBlock x:Name="PromptTextBlock" Grid.Row="1" Text="This item is currently locked. Type the text below exactly as shown. Copy-paste is disabled."
                       FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16" />

            <!-- Challenge Box -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusButton}" Padding="14,12" Margin="0,0,0,14">
                <TextBlock x:Name="ChallengeTextBlock"
                           FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource FontSize13}"
                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"
                           LineHeight="20" IsHitTestVisible="False" Focusable="False" />
            </Border>

            <!-- Input Box -->
            <StackPanel Grid.Row="3" Margin="0,0,0,6">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Type challenge here:" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CharCountText" Grid.Column="1" Text="0 / 80" FontFamily="{DynamicResource FontMono}"
                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                </Grid>
                <TextBox x:Name="InputTextBox" Height="34" VerticalContentAlignment="Center"
                         FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource FontSize13}"
                         Padding="8,4" TextChanged="InputTextBox_TextChanged" />
            </StackPanel>

            <!-- Error text -->
            <TextBlock x:Name="ErrorTextBlock" Grid.Row="4" Foreground="{DynamicResource Danger}" FontSize="{DynamicResource FontSize12}"
                       Margin="0,0,0,12" Visibility="Collapsed" TextWrapping="Wrap" />

            <!-- Spacer -->
            <Grid Grid.Row="5" />

            <!-- Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="UnlockButton" Content="Unlock" Click="UnlockButton_Click"
                        Padding="20,8" MinWidth="100" Margin="0,0,10,0" IsDefault="True" />
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"
                        Padding="16,8" MinWidth="80" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
