<Window x:Class="Blocker.App.UniversalNotesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blocker.App"
        local:WindowHelper.UseThemeTitleBar="True"
        Title="Meditation Journal &amp; Universal Notes"
        Width="720" Height="540"
        MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource FontBody}">

    <Window.Resources>
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />

        <Style x:Key="SessionListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SurfaceRaised}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SurfaceRaised}" />
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="itemBorder" Property="BorderThickness" Value="2,0,0,1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Bg}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Header & Search -->
                <RowDefinition Height="Auto" />
                <!-- Master / Detail Grid -->
                <RowDefinition Height="*" />
                <!-- Footer Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header & Search Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Meditation Journal &amp; Universal Notes"
                               FontFamily="{DynamicResource FontTitle}"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource FontSizeHeading}"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="Historical reflections and contemplation records across all focus sessions."
                               FontSize="{DynamicResource FontSize12}"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Search Filter Box -->
                <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="{DynamicResource RadiusInput}" Padding="8,2" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="Search reflections..." FontSize="{DynamicResource FontSize12}"
                                   Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center" Margin="2,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FontSize12}"
                                 VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Master / Detail Body -->
            <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Master List: Past Sessions -->
                        <ColumnDefinition Width="280" />
                        <!-- Divider -->
                        <ColumnDefinition Width="1" />
                        <!-- Detail Pane: Full Reflections -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Master List -->
                    <ListBox Grid.Column="0" x:Name="SessionsListBox"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SessionListBoxItemStyle}"
                             SelectionChanged="SessionsListBox_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Date and Status Badge -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayDate}" FontWeight="SemiBold"
                                                   FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" Background="{Binding StatusBadgeBackground}"
                                                CornerRadius="3" Padding="5,1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusBadgeForeground}" />
                                        </Border>
                                    </Grid>

                                    <!-- Duration & Soundscape -->
                                    <TextBlock Text="{Binding DurationAndSoundscape}" FontSize="{DynamicResource FontSize12}"
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />

                                    <!-- Note preview snippet -->
                                    <TextBlock Text="{Binding NoteSnippet}" FontSize="{DynamicResource FontSize12}"
                                               Foreground="{DynamicResource TextDisabled}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Vertical Separator -->
                    <Rectangle Grid.Column="1" Fill="{DynamicResource Border}" />

                    <!-- Detail Pane -->
                    <Grid Grid.Column="2" x:Name="DetailContainer" Margin="16,14">
                        <!-- When No Selection -->
                        <StackPanel x:Name="NoSelectionPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolderOpen}" Width="28" Height="28"
                                  Stroke="{DynamicResource TextDisabled}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="Select a session from the list to view its reflection notes."
                                       FontSize="{DynamicResource FontSize13}" Foreground="{DynamicResource TextSecondary}"
                                       TextAlignment="Center" />
                        </StackPanel>

                        <!-- Selected Session Content -->
                        <Grid x:Name="SelectedDetailPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Detail Header -->
                            <Border Grid.Row="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="DetailTitleTextBlock" Text="November 6, 2026 - 3:00 PM"
                                                   FontFamily="{DynamicResource FontTitle}"
                                                   FontSize="{DynamicResource FontSizeHeading}"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock x:Name="DetailMetaTextBlock" Text="20 mins meditated • 🌧 Rain Soundscape"
                                                   FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" x:Name="DetailBadgeBorder" Background="{DynamicResource SurfaceRaised}"
                                            BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusPill}" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock x:Name="DetailBadgeText" Text="Completed" FontSize="{DynamicResource FontSize12}"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Success}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Detail Reflection Note Text -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="ReflectionDetailTextBox" Background="Transparent" BorderThickness="0"
                                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         FontSize="{DynamicResource FontSize13}" Foreground="{DynamicResource TextPrimary}"
                                         Padding="0" VerticalScrollBarVisibility="Disabled" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Footer Bar -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- Summary Stats -->
                    <ColumnDefinition Width="*" />
                    <!-- Actions -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryStatsTextBlock" Text="0 sessions completed • 0 minutes meditated"
                               FontSize="{DynamicResource FontSize12}" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock x:Name="ExportStatusMessage" Text="" FontSize="{DynamicResource FontSize12}"
                               Foreground="{DynamicResource Success}" Margin="0,2,0,0"
                               Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringNotEmptyToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Export to Markdown" Style="{StaticResource SecondaryButton}"
                            Padding="14,7" Margin="0,0,8,0" Click="ExportMarkdown_Click" />
                    <Button Content="Close" Style="{StaticResource SecondaryButton}" Padding="16,7"
                            Click="CloseButton_Click" MinWidth="75" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>