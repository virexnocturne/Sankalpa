                            <Setter TargetName="rmvBorder" Property="BorderBrush" Value="{DynamicResource DangerSubtleBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerSubtleTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="rmvBorder" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

