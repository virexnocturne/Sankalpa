<Window x:Class="Blocker.App.AppPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blocker.App"
        Title="Pick Applications"
        Width="640" Height="580"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextLightBrush}">

    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Header Row Template -->
        <DataTemplate x:Key="HeaderTemplate">
            <Border Background="{DynamicResource SurfacePillBrush}" Padding="8,5" Margin="0,6,0,2" CornerRadius="4">
                <TextBlock Text="{Binding HeaderTitle}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentBlueBrush}" />
            </Border>
        </DataTemplate>

        <!-- App Row Template -->
        <DataTemplate x:Key="AppRowTemplate">
            <Border Background="Transparent" Padding="8,6" CornerRadius="3"
                    PreviewMouseLeftButtonDown="AppRow_PreviewMouseLeftButtonDown"
                    Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,12,0"
                              Focusable="False" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextLightBrush}" />
                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                   Visibility="{Binding Path, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic"
                               Margin="8,0,4,0"
                               Visibility="{Binding IsAlreadyBlocked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <local:AppPickerTemplateSelector x:Key="AppPickerTemplateSelector"
                                         HeaderTemplate="{StaticResource HeaderTemplate}"
                                         AppRowTemplate="{StaticResource AppRowTemplate}" />

        <!-- ListBoxItem style for picker -->
        <Style x:Key="PickerListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Focusable" Value="{Binding IsSelectable}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Focusable" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfacePillBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title & Search -->
                <RowDefinition Height="Auto" />
                <!-- Filter checkbox -->
                <RowDefinition Height="Auto" />
                <!-- Flat ListBox & Loading overlay -->
                <RowDefinition Height="*" />
                <!-- Action Buttons -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ROW 0: Title & Search -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Pick Applications" FontWeight="SemiBold" FontSize="18"
                           Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,12" />

                <Grid>
                    <TextBox x:Name="SearchTextBox" Height="32" VerticalContentAlignment="Center"
                             Padding="8,4" TextChanged="SearchTextBox_TextChanged" />
                    <TextBlock x:Name="SearchPlaceholder" Text="Search applications by name or path..."
                               IsHitTestVisible="False" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" />
                </Grid>
            </StackPanel>

            <!-- ROW 1: Options -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <CheckBox x:Name="ShowAllProcessesCheckBox" Content="Show all processes (includes system &amp; background)"
                          Click="ShowAllProcessesCheckBox_Click" FontSize="12" />
            </Grid>

            <!-- ROW 2: Flat ListBox with Loading overlay -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <ListBox x:Name="AppsListBox"
                         VirtualizingPanel.IsVirtualizing="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource BgCardBrush}"
                         BorderBrush="{DynamicResource BorderDarkBrush}"
                         BorderThickness="1"
                         ItemTemplateSelector="{StaticResource AppPickerTemplateSelector}"
                         ItemContainerStyle="{StaticResource PickerListBoxItemStyle}"
                         SelectionChanged="AppsListBox_SelectionChanged" />

                <!-- Empty search notice -->
                <TextBlock x:Name="EmptyNoticeTextBlock" Text="No matching applications found."
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />

                <!-- Loading Overlay -->
                <Border x:Name="LoadingOverlay" Background="{DynamicResource SurfacePillBrush}" Opacity="0.9" Visibility="Collapsed" CornerRadius="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Loading applications..." Foreground="{DynamicResource TextLightBrush}"
                                   FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ROW 3: Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SelectedSummaryTextBlock" Text="Select one or more applications to add."
                           VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="AddSelectedButton" Content="Add selected (0)" IsEnabled="False"
                            Click="AddSelectedButton_Click" Padding="18,8" MinWidth="130" Margin="0,0,8,0" />
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"
                            Padding="16,8" MinWidth="80" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
