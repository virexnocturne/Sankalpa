<UserControl x:Class="Blocker.App.SoundscapePillControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Blocker.App">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />

        <Style x:Key="PillTriggerButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceRaised}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Bg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrackItemButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize12}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- The Compact Soundscape Pill Button -->
        <Button Command="{Binding ToggleSoundscapeMenuCommand}"
                Style="{StaticResource PillTriggerButtonStyle}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                ToolTip="Select ambient soundscape and volume">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Style="{StaticResource Icon}"
                      Data="{StaticResource IconVolume}"
                      Width="12" Height="12"
                      Stroke="{DynamicResource Accent}"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center" />

                <TextBlock Text="{Binding SelectedSoundscapeDisplayName}"
                           FontFamily="{DynamicResource FontBody}"
                           FontSize="{DynamicResource FontSize12}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" />

                <Path Style="{StaticResource Icon}"
                      Data="{StaticResource IconChevronDown}"
                      Width="9" Height="9"
                      Stroke="{DynamicResource TextSecondary}"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Expandable Flyout / Dropdown Panel -->
        <Border Margin="0,38,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="240"
                Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderStrong}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusCard}"
                Padding="12"
                Visibility="{Binding IsSoundscapeMenuOpen, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="100">
            <StackPanel>
                <!-- Flyout Header -->
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="AMBIENT SOUNDSCAPE"
                               FontFamily="{DynamicResource FontTitle}"
                               FontSize="{DynamicResource FontSize12}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextDisabled}"
                               VerticalAlignment="Center" />

                    <Button Command="{Binding ToggleSoundscapeMenuCommand}"
                            Style="{StaticResource IconButton}"
                            Width="20" Height="20"
                            Padding="2"
                            HorizontalAlignment="Right"
                            ToolTip="Close Menu">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconX}" Width="10" Height="10"
                              Stroke="{DynamicResource TextSecondary}" />
                    </Button>
                </Grid>

                <!-- Track 1: Rain -->
                <Button Content="Rain"
                        Command="{Binding SelectSoundscapeCommand}" CommandParameter="Rain"
                        Padding="10,6" Margin="0,0,0,3" FontSize="{DynamicResource FontSize12}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRainSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Track 2: Library -->
                <Button Content="Library"
                        Command="{Binding SelectSoundscapeCommand}" CommandParameter="Library"
                        Padding="10,6" Margin="0,0,0,3" FontSize="{DynamicResource FontSize12}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLibrarySelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Track 3: Forest -->
                <Button Content="Forest"
                        Command="{Binding SelectSoundscapeCommand}" CommandParameter="Forest"
                        Padding="10,6" Margin="0,0,0,3" FontSize="{DynamicResource FontSize12}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsForestSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Track 4: Singing Bowls -->
                <Button Content="Singing Bowls"
                        Command="{Binding SelectSoundscapeCommand}" CommandParameter="SingingBowls"
                        Padding="10,6" Margin="0,0,0,3" FontSize="{DynamicResource FontSize12}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBowlsSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Track 5: Mute -->
                <Button Content="Mute"
                        Command="{Binding SelectSoundscapeCommand}" CommandParameter="None"
                        Padding="10,6" Margin="0,0,0,10" FontSize="{DynamicResource FontSize12}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMuteSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Separator Background="{DynamicResource Border}" Margin="0,2,0,10" />

                <!-- Volume Slider & Playback Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Play / Pause -->
                    <Button Grid.Column="0"
                            Command="{Binding ToggleSoundscapeCommand}"
                            Style="{StaticResource IconButton}"
                            Width="26" Height="26"
                            Margin="0,0,8,0"
                            ToolTip="Play / Pause Audio">
                        <Grid>
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlay}" Width="10" Height="10"
                                  Stroke="{DynamicResource TextPrimary}"
                                  Visibility="{Binding IsSoundscapePlaying, Converter={StaticResource InvBoolToVis}}" />
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconPause}" Width="10" Height="10"
                                  Stroke="{DynamicResource Accent}"
                                  Visibility="{Binding IsSoundscapePlaying, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>

                    <!-- Volume Slider -->
                    <Slider Grid.Column="1"
                            Minimum="0" Maximum="100"
                            Value="{Binding SoundscapeVolume, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip="Volume" />

                    <!-- Percentage Label -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding SoundscapeVolumeText}"
                               FontFamily="{DynamicResource FontMono}"
                               FontSize="{DynamicResource FontSize12}"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Width="32"
                               TextAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
