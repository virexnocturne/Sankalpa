<Window x:Class="Blocker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Blocker.App"
        local:WindowHelper.UseThemeTitleBar="True"
        mc:Ignorable="d"
        Title="Sankalpa"
        Icon="Assets/app.ico"
        Height="720" Width="860"
        MinHeight="600" MinWidth="680"
        WindowState="Maximized"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource FontBody}"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="B" Command="{Binding CreateProfileCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding ToggleSettingsCommand}" />
        <KeyBinding Modifiers="Control" Key="M" Command="{Binding OpenMeditationCommand}" />
        <KeyBinding Modifiers="Alt" Key="N" Command="{Binding Meditation.ToggleQuickNotesCommand}" />
        <KeyBinding Modifiers="Control+Alt" Key="M" Command="{Binding Meditation.OpenEditDialogCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="U" Command="{Binding Meditation.ToggleSoundscapeCommand}" />
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding Meditation.NewNoteCommand}" />

    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
        <local:NullToVisibilityConverter x:Key="NullToVis" />
        <local:InverseNullToVisibilityConverter x:Key="InvNullToVis" />

        <!-- Top Navigation Tab Button Style -->
        <Style x:Key="TopNavTabButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,10,14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Summary Badge Button Style -->
        <Style x:Key="SummaryBadgeButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat Lock Label Button Style -->
        <Style x:Key="FlatLockLabelButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Status Bar Interactive Button Style -->
        <Style x:Key="StatusBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceRaised}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Bg}">
        <Grid.RowDefinitions>
            <!-- 0: Warning Banners -->
            <RowDefinition Height="Auto" />
            <!-- 1: Top Navigation Tab Bar -->
            <RowDefinition Height="Auto" />
            <!-- 2: Main Body -->
            <RowDefinition Height="*" />
            <!-- 3: Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: WARNING BANNERS -->
        <StackPanel Grid.Row="0">
            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Warning}" BorderThickness="0,0,0,1" Padding="20,8"
                    Visibility="{Binding IsServiceConnected, Converter={StaticResource InvBoolToVis}}">
                <Grid MaxWidth="920">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Background service is not running. Blocks will not be enforced."
                               FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource Warning}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Retry connection" Command="{Binding RetryConnectionCommand}"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Warning}" Foreground="{DynamicResource Warning}" Padding="12,4" FontSize="{DynamicResource FontSize12}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Warning}" BorderThickness="0,0,0,1" Padding="20,6"
                    Visibility="{Binding ShowWebsiteWarningBanner, Converter={StaticResource BoolToVis}}">
                <Grid MaxWidth="920">
                    <TextBlock Text="{Binding WebsiteWarningBannerText}"
                               FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource Warning}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding WarningBanners}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Warning}" BorderThickness="0,0,0,1" Padding="20,6">
                            <Grid MaxWidth="920">
                                <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource Warning}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ROW 1: TOP BAR -->
        <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1" Padding="16,0">
            <Grid MaxWidth="920">
                <Grid.ColumnDefinitions>
                    <!-- Tabs -->
                    <ColumnDefinition Width="*" />
                    <!-- Right utility buttons -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Tab 1: Website & App Blocks -->
                    <Button Command="{Binding BackToBlocksCommand}" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TopNavTabButtonStyle}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBlocksViewActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Bg}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconShield}" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBlocksViewActive}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="Website &amp; App Blocks" FontWeight="SemiBold" FontSize="{DynamicResource FontSize13}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBlocksViewActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Tab 2: Meditation & Lockdown -->
                    <Button Command="{Binding OpenMeditationCommand}" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TopNavTabButtonStyle}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMeditationViewActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Bg}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconLotus}" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMeditationViewActive}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="Meditation &amp; Lockdown" FontWeight="SemiBold" FontSize="{DynamicResource FontSize13}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMeditationViewActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right Utility Icons (Settings) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleSettingsCommand}" Style="{StaticResource IconButton}"
                            ToolTip="Settings" Width="30" Height="30">
                        <Path Data="{StaticResource IconSettings}" Width="16" Height="16"
                              VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsViewActive}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2: MAIN BODY (Blocks View or In-Window Settings View) -->
        <Grid Grid.Row="2" Background="{DynamicResource Bg}">
            <!-- 1. BLOCKS VIEW -->
            <ScrollViewer Visibility="{Binding IsBlocksViewActive, Converter={StaticResource BoolToVis}}"
                          Background="{DynamicResource Bg}" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="920" Margin="20,20,20,16">
                    <!-- Title Header Row -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Website &amp; App Blocks" FontFamily="{DynamicResource FontTitle}"
                                   FontSize="{DynamicResource FontSizeHeading}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />

                        <!-- Primary Header Add Button -->
                        <Button Grid.Column="1" Command="{Binding NewBlockCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="14,6" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold"
                                VerticalAlignment="Center">
                            <TextBlock Text="+ New block" Foreground="{DynamicResource TextOnAccent}" FontWeight="SemiBold" />
                        </Button>
                    </Grid>

                    <!-- Feedback Toast -->
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextPrimary}"
                               FontSize="{DynamicResource FontSize12}" FontWeight="Normal" Margin="0,0,0,10"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVis}}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}"
                               FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" Margin="0,0,0,10"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVis}}" />

                    <!-- Cards List -->
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface}"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource Border}"
                                        CornerRadius="{DynamicResource RadiusCard}"
                                        Padding="{Binding CardPadding}" Margin="{Binding CardMargin}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!-- Line 1: Name and Toggle -->
                                            <RowDefinition Height="Auto" />
                                            <!-- Line 1b: Active Session Pill (if running) -->
                                            <RowDefinition Height="Auto" />
                                            <!-- Line 2: Horizontal Metadata Columns -->
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Line 1: Name and Toggle -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Profile Name (Double-click to inline edit) -->
                                            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <!-- View Mode: Double-click to rename -->
                                                <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource FontTitle}"
                                                           FontSize="{DynamicResource FontSize16}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                                           Cursor="Hand" ToolTip="Double-click to rename block"
                                                           Visibility="{Binding IsEditingName, Converter={StaticResource InvBoolToVis}}"
                                                           MouseLeftButtonDown="ProfileName_MouseLeftButtonDown">
                                                    <TextBlock.InputBindings>
                                                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding BeginEditNameCommand}" />
                                                    </TextBlock.InputBindings>
                                                </TextBlock>

                                                <!-- Edit Mode: Inline TextBox -->
                                                <TextBox x:Name="InlineNameTextBox"
                                                         Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                                                         FontFamily="{DynamicResource FontTitle}"
                                                         FontSize="{DynamicResource FontSize16}" FontWeight="SemiBold"
                                                         Foreground="{DynamicResource TextPrimary}"
                                                         Background="{DynamicResource SurfaceRaised}"
                                                         BorderBrush="{DynamicResource Accent}"
                                                         BorderThickness="1"
                                                         Padding="6,3"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVis}}"
                                                         IsVisibleChanged="InlineNameTextBox_IsVisibleChanged"
                                                         KeyDown="InlineNameTextBox_KeyDown"
                                                         LostFocus="InlineNameTextBox_LostFocus" />
                                            </Grid>

                                            <!-- Toggle Switch with On/Off Label -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding IsToggleChecked, Mode=OneWay}"
                                                          IsEnabled="{Binding CanToggle}"
                                                          Click="ToggleSwitch_Click"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          ToolTip="Toggle block on/off"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding OnOffText}" Width="26" FontSize="{DynamicResource FontSize12}" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Line 1b: Live Active Focus Session (if running) -->
                                        <Border Grid.Row="1" CornerRadius="{DynamicResource RadiusButton}" Padding="10,4" Margin="0,0,0,8"
                                                Background="{DynamicResource SurfaceRaised}"
                                                BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding IsSessionRunning, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconClock}"
                                                      Stroke="{DynamicResource Accent}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Active session: " FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SessionRemainingFormatted}" FontFamily="{DynamicResource FontMono}"
                                                           FontSize="{DynamicResource FontSize12}" FontWeight="Bold"
                                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                                <TextBlock Text=" remaining" FontSize="{DynamicResource FontSize12}"
                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Line 2: Proportional Metadata Columns & Actions -->
                                        <Grid Grid.Row="2" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <!-- Col 0: Schedule / Frequency -->
                                                <ColumnDefinition Width="1.5*" />
                                                <!-- Col 1: Apps & Sites Summary -->
                                                <ColumnDefinition Width="1.5*" />
                                                <!-- Col 2: Lock Status -->
                                                <ColumnDefinition Width="1.1*" />
                                                <!-- Col 3: Action Buttons -->
                                                <ColumnDefinition Width="144" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Col 0: Schedule status (Click opens Schedule tab) -->
                                            <Button Grid.Column="0"
                                                    Command="{Binding DataContext.OpenScheduleTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource FlatLockLabelButtonStyle}"
                                                    ToolTip="Click to edit schedule">
                                                <TextBlock Text="{Binding ScheduleColText}" FontSize="{DynamicResource FontSize12}"
                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                            </Button>

                                            <!-- Col 1: Apps & Sites Flat Text Buttons -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Apps button -->
                                                <Button Command="{Binding DataContext.OpenAppsTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource FlatLockLabelButtonStyle}"
                                                        Margin="0,0,12,0"
                                                        ToolTip="Click to edit applications">
                                                    <TextBlock Text="{Binding AppsBadgeText}" FontSize="{DynamicResource FontSize12}"
                                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                                </Button>

                                                <!-- Sites button -->
                                                <Button Command="{Binding DataContext.OpenSitesTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource FlatLockLabelButtonStyle}"
                                                        Margin="0,0,12,0"
                                                        ToolTip="Click to edit websites">
                                                    <TextBlock Text="{Binding SitesBadgeText}" FontSize="{DynamicResource FontSize12}"
                                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                                </Button>

                                                <!-- Exceptions button (if any) -->
                                                <Button Command="{Binding DataContext.OpenSitesTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource FlatLockLabelButtonStyle}"
                                                        Visibility="{Binding HasExceptions, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Click to edit website exceptions">
                                                    <TextBlock Text="{Binding ExceptionsBadgeText}" FontSize="{DynamicResource FontSize12}"
                                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>

                                            <!-- Col 2: Lock Status (Click opens Lock Protection tab, constrained to text width) -->
                                            <Button Grid.Column="2" HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.OpenLockTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource FlatLockLabelButtonStyle}"
                                                    ToolTip="Click to open Lock Protection">
                                                <TextBlock Text="{Binding LockColText}" FontSize="{DynamicResource FontSize12}"
                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                            </Button>

                                            <!-- Col 3: Actions (Edit, Delete) -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                                                <!-- Edit button -->
                                                <Button Content="Edit"
                                                        Command="{Binding DataContext.EditBlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanEdit}"
                                                        Style="{StaticResource CardActionButton}" Margin="0,0,6,0" />

                                                <!-- Delete button -->
                                                <Button Command="{Binding DataContext.DeleteBlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource IconButton}" Width="26" Height="26" Padding="6"
                                                        IsEnabled="{Binding CanDelete}"
                                                        ToolTip="Delete block" VerticalAlignment="Center">
                                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconTrash}"
                                                          Stroke="{DynamicResource TextSecondary}"
                                                          Stretch="Uniform" Width="12" Height="12" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State Card (Visible when Profiles.Count == 0) -->
                    <Border Background="{DynamicResource Surface}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Border}"
                            CornerRadius="{DynamicResource RadiusCard}"
                            Padding="32,48" Margin="0,12,0,0"
                            HorizontalAlignment="Stretch">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32"
                                    Background="{DynamicResource SurfaceRaised}"
                                    BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconShield}"
                                      Stroke="{DynamicResource TextSecondary}"
                                      Width="28" Height="28"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="No Block Profiles Yet"
                                       FontFamily="{DynamicResource FontTitle}"
                                       FontSize="{DynamicResource FontSizeHeading}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Create your first block profile to block distracting websites and apps."
                                       FontSize="{DynamicResource FontSize13}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="420"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,20" />

                            <Button Command="{Binding OpenNewBlockDialogCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="18,8"
                                    FontSize="{DynamicResource FontSize13}"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlus}"
                                          Stroke="{DynamicResource TextOnAccent}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="+ New Block" Foreground="{DynamicResource TextOnAccent}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 2. IN-WINDOW SETTINGS VIEW -->
            <ScrollViewer Visibility="{Binding IsSettingsViewActive, Converter={StaticResource BoolToVis}}"
                          Background="{DynamicResource Bg}" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="920" Margin="20,20,20,24">
                    <!-- Settings Header Row -->
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Settings" FontFamily="{DynamicResource FontTitle}"
                                       FontSize="{DynamicResource FontSizeHeading}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="Personalize theme appearance, interface density, and time display format."
                                       FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding BackToBlocksCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,6" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconArrowLeft}"
                                      Stroke="{DynamicResource TextPrimary}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Back to Blocks" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- CATEGORY 1: PERSONALISATION -->
                    <TextBlock Text="PERSONALISATION" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                               Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,10" />

                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="20" Margin="0,0,0,22">
                        <StackPanel>
                            <!-- Theme Selection -->
                            <Grid Margin="0,0,0,18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Theme" FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" />
                                    <TextBlock Text="Choose between Black, White, or Grey theme."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Column="0" GroupName="SettingsThemeGroup"
                                                 IsChecked="{Binding IsThemeBlack, Mode=TwoWay}"
                                                 Content="Black" FontWeight="SemiBold" />

                                    <RadioButton Grid.Column="2" GroupName="SettingsThemeGroup"
                                                 IsChecked="{Binding IsThemeWhite, Mode=TwoWay}"
                                                 Content="White" FontWeight="SemiBold" />

                                    <RadioButton Grid.Column="4" GroupName="SettingsThemeGroup"
                                                 IsChecked="{Binding IsThemeGrey, Mode=TwoWay}"
                                                 Content="Grey" FontWeight="SemiBold" />
                                </Grid>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,18" />

                            <!-- Accent Color -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Accent Color" FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" />
                                    <TextBlock Text="Highlight color for primary buttons, switches, and active indicators."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>

                                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                    <!-- Emerald -->
                                    <RadioButton GroupName="SettingsAccentGroup" IsChecked="{Binding IsAccentEmerald, Mode=TwoWay}"
                                                 Margin="0,0,24,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="16" Height="16" CornerRadius="8" Background="#229B62" Margin="0,0,8,0" />
                                            <TextBlock Text="Emerald" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- Indigo -->
                                    <RadioButton GroupName="SettingsAccentGroup" IsChecked="{Binding IsAccentIndigo, Mode=TwoWay}"
                                                 Margin="0,0,24,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="16" Height="16" CornerRadius="8" Background="#4F46E5" Margin="0,0,8,0" />
                                            <TextBlock Text="Indigo" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- Violet -->
                                    <RadioButton GroupName="SettingsAccentGroup" IsChecked="{Binding IsAccentViolet, Mode=TwoWay}"
                                                 Margin="0,0,24,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="16" Height="16" CornerRadius="8" Background="#7C3AED" Margin="0,0,8,0" />
                                            <TextBlock Text="Violet" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- Amber -->
                                    <RadioButton GroupName="SettingsAccentGroup" IsChecked="{Binding IsAccentAmber, Mode=TwoWay}"
                                                 Margin="0,0,24,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="16" Height="16" CornerRadius="8" Background="#D97706" Margin="0,0,8,0" />
                                            <TextBlock Text="Amber" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- Rose -->
                                    <RadioButton GroupName="SettingsAccentGroup" IsChecked="{Binding IsAccentRose, Mode=TwoWay}"
                                                 Margin="0,0,24,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="16" Height="16" CornerRadius="8" Background="#E11D48" Margin="0,0,8,0" />
                                            <TextBlock Text="Rose" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- Slate -->
                                    <RadioButton GroupName="SettingsAccentGroup" IsChecked="{Binding IsAccentSlate, Mode=TwoWay}"
                                                 Margin="0,0,24,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="16" Height="16" CornerRadius="8" Background="#475569" Margin="0,0,8,0" />
                                            <TextBlock Text="Slate" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </WrapPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CATEGORY 2: INTERFACE -->
                    <TextBlock Text="INTERFACE" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                               Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,10" />

                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="20" Margin="0,0,0,24">
                        <StackPanel>
                            <!-- Card Density -->
                            <Grid Margin="0,0,0,18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Card Density" FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" />
                                    <TextBlock Text="Adjust spacing and vertical height of block cards on your dashboard."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Column="0" GroupName="SettingsDensityGroup"
                                                 IsChecked="{Binding IsDensityComfortable, Mode=TwoWay}"
                                                 Content="Comfortable (Spacious)" FontWeight="SemiBold" />

                                    <RadioButton Grid.Column="2" GroupName="SettingsDensityGroup"
                                                 IsChecked="{Binding IsDensityCompact, Mode=TwoWay}"
                                                 Content="Compact (High density)" FontWeight="SemiBold" />
                                </Grid>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,18" />

                            <!-- Time Format -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Time Display Format" FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" />
                                    <TextBlock Text="Choose how times are formatted across schedules, countdowns, and active block windows."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Column="0" GroupName="SettingsTimeGroup"
                                                 IsChecked="{Binding IsTimeFormat12h, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="12-Hour" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="(e.g. 2:30 PM)" FontFamily="{DynamicResource FontMono}"
                                                       Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSize12}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton Grid.Column="2" GroupName="SettingsTimeGroup"
                                                 IsChecked="{Binding IsTimeFormat24h, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="24-Hour" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="(e.g. 14:30)" FontFamily="{DynamicResource FontMono}"
                                                       Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSize12}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CATEGORY 3: NOTIFICATIONS & ALERTS -->
                    <TextBlock Text="NOTIFICATIONS &amp; ALERTS" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                               Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,10" />

                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="20" Margin="0,0,0,24">
                        <StackPanel>
                            <!-- Windows Disabled Warning Banner -->
                            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Warning}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusButton}" Padding="14,12" Margin="0,0,0,18"
                                    Visibility="{Binding IsWindowsNotificationDisabled, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource IconInfo}"
                                          Stroke="{DynamicResource Warning}" Width="16" Height="16" Margin="0,2,12,0" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Notifications are turned off in Windows Settings" FontWeight="SemiBold"
                                                   FontSize="{DynamicResource FontSize13}" Foreground="{DynamicResource Warning}" Margin="0,0,0,2" />
                                        <TextBlock Text="Windows is currently blocking all notifications for Sankalpa. You will not receive alerts for blocked apps, browsers, or DNS security until allowed in Windows."
                                                   FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Open Windows Settings"
                                            Command="{Binding OpenWindowsNotificationSettingsCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Center" Margin="14,0,0,0" Padding="12,6"
                                            FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" />
                                </Grid>
                            </Border>

                            <!-- Master Notifications Switch -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconBell}"
                                              Stroke="{DynamicResource Accent}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Desktop Toast Notifications" FontFamily="{DynamicResource FontTitle}"
                                                   FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Display on-screen alerts when a blocked app, browser session, or DNS tamper event occurs."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding AreNotificationsEnabled, Mode=TwoWay}"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          ToolTip="Toggle All Notifications"
                                          VerticalAlignment="Center" />
                            </Grid>

                            <!-- Sub-channels -->
                            <StackPanel IsEnabled="{Binding AreNotificationsEnabled}">
                                <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,16" />

                                <TextBlock Text="Notification Channels" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" />

                                <!-- App Block Alerts -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="App Block Notifications" FontSize="{DynamicResource FontSize13}" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2" />
                                        <TextBlock Text="Show a notification popup when a blocked desktop app or game is terminated."
                                                   FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding ShowAppAlerts, Mode=TwoWay}"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center" />
                                </Grid>

                                <!-- Browser Security Warnings -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Browser Security Warnings" FontSize="{DynamicResource FontSize13}" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2" />
                                        <TextBlock Text="Warn before browser closure if the Sankalpa companion extension is inactive or disabled."
                                                   FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding ShowBrowserAlerts, Mode=TwoWay}"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center" />
                                </Grid>

                                <!-- DNS Security Alerts -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="DNS Security Alerts" FontSize="{DynamicResource FontSize13}" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2" />
                                        <TextBlock Text="Alert when DNS tampering is detected and filtered DNS resolvers are restored."
                                                   FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding ShowDnsAlerts, Mode=TwoWay}"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CATEGORY 4: SECURE DNS SHIELD & CONTENT FILTER -->
                    <TextBlock Text="DNS SHIELD &amp; CONTENT FILTER" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                               Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,10" />

                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="20" Margin="0,0,0,24">
                        <StackPanel>
                            <!-- Header with Toggle and Lock Indicator -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconShield}"
                                              Stroke="{DynamicResource Accent}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Secure DNS Protection" FontFamily="{DynamicResource FontTitle}"
                                                   FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />

                                        <!-- Locked Indicator Badge -->
                                        <Border CornerRadius="{DynamicResource RadiusButton}" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Background="{DynamicResource SurfaceRaised}"
                                                BorderBrush="{DynamicResource Warning}" BorderThickness="1"
                                                Visibility="{Binding IsDnsLocked, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconLock}"
                                                      Stroke="{DynamicResource Warning}" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Locked" FontSize="{DynamicResource FontSize12}" FontWeight="Bold" Foreground="{DynamicResource Warning}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DnsLockRemainingFormatted, StringFormat=' ({0})'}"
                                                           FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource FontSize12}"
                                                           Foreground="{DynamicResource TextPrimary}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding DnsLockRemainingFormatted, Converter={StaticResource StringNotEmptyToVis}}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Route Windows network traffic through filtered DNS servers to enforce adult/malware protection at the OS level."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- On/Off Toggle -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="DnsToggleSwitch"
                                              IsChecked="{Binding IsDnsEnabled, Mode=OneWay}"
                                              Click="DnsToggleSwitch_Click"
                                              IsEnabled="{Binding CanEditDns}"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              ToolTip="Toggle DNS Protection"
                                              VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,16" />

                            <!-- Presets Selection -->
                            <StackPanel Margin="0,0,0,16" IsEnabled="{Binding CanEditDns}">
                                <TextBlock Text="Resolver Preset" FontSize="{DynamicResource FontSize13}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Cloudflare Family -->
                                    <RadioButton Grid.Row="0" Grid.Column="0" GroupName="DnsPresetGroup" Margin="0,0,8,10"
                                                 IsChecked="{Binding IsPresetCloudflare, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock Text="Cloudflare Family" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}">
                                                <Run Text="1.1.1.3" FontFamily="{DynamicResource FontMono}" />
                                                <Run Text=" (Malware &amp; Adult filter)" />
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- CleanBrowsing -->
                                    <RadioButton Grid.Row="0" Grid.Column="1" GroupName="DnsPresetGroup" Margin="0,0,0,10"
                                                 IsChecked="{Binding IsPresetCleanBrowsing, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock Text="CleanBrowsing" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}">
                                                <Run Text="185.228.168.168" FontFamily="{DynamicResource FontMono}" />
                                                <Run Text=" (Adult &amp; Malicious filter)" />
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- Quad9 -->
                                    <RadioButton Grid.Row="1" Grid.Column="0" GroupName="DnsPresetGroup" Margin="0,0,8,0"
                                                 IsChecked="{Binding IsPresetQuad9, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock Text="Quad9" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}">
                                                <Run Text="9.9.9.9" FontFamily="{DynamicResource FontMono}" />
                                                <Run Text=" (Malware &amp; Phishing filter)" />
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>

                                <!-- Custom Preset Option -->
                                <RadioButton GroupName="DnsPresetGroup" Margin="0,8,0,0"
                                             IsChecked="{Binding IsPresetCustom, Mode=TwoWay}">
                                    <TextBlock Text="Custom DNS Resolvers" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                </RadioButton>
                            </StackPanel>

                            <!-- Custom DNS Inputs (visible when Custom is selected) -->
                            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusCard}" Padding="12" Margin="0,0,0,16"
                                    Visibility="{Binding IsCustomDns, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Primary DNS (IPv4)" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding PrimaryDns, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource FontMono}"
                                                 IsEnabled="{Binding CanEditDns}" Height="32" Padding="8,4"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Secondary DNS (Optional)" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding SecondaryDns, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource FontMono}"
                                                 IsEnabled="{Binding CanEditDns}" Height="32" Padding="8,4"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                                    </StackPanel>

                                    <Button Grid.Column="4" Content="Apply DNS"
                                            Command="{Binding SaveDnsSettingsCommand}"
                                            IsEnabled="{Binding CanEditDns}"
                                            Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Bottom" Height="32" Padding="14,0" />
                                </Grid>
                            </Border>

                            <!-- Divider -->
                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,16" />

                            <!-- Lock Controls -->
                            <StackPanel>
                                <!-- UNLOCKED STATE: Configuration for Locking -->
                                <StackPanel Visibility="{Binding IsDnsLocked, Converter={StaticResource InvBoolToVis}}">
                                    <TextBlock Text="Enforce &amp; Lock DNS" FontSize="{DynamicResource FontSize13}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                    <TextBlock Text="Lock DNS protection for a set duration or with a typing challenge. During a lock, settings cannot be disabled or bypassed until time expires."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <RadioButton Content="Duration Lock" GroupName="DnsLockModeGroup"
                                                     IsChecked="{Binding IsDnsLockTimer, Mode=TwoWay}"
                                                     FontWeight="SemiBold" Margin="0,0,24,0" />
                                        <RadioButton Content="64-Char Typing Challenge" GroupName="DnsLockModeGroup"
                                                     IsChecked="{Binding IsDnsLockChallenge, Mode=TwoWay}"
                                                     FontWeight="SemiBold" />
                                    </StackPanel>

                                    <!-- Duration Selector if Timer Lock -->
                                    <StackPanel Visibility="{Binding IsDnsLockTimer, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                        <TextBlock Text="Quick Presets" FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="1 hour" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding SetDnsPresetDurationCommand}" CommandParameter="1h"
                                                    Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                            <Button Grid.Column="2" Content="4 hours" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding SetDnsPresetDurationCommand}" CommandParameter="4h"
                                                    Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                            <Button Grid.Column="4" Content="1 day" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding SetDnsPresetDurationCommand}" CommandParameter="1d"
                                                    Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                            <Button Grid.Column="6" Content="3 days" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding SetDnsPresetDurationCommand}" CommandParameter="3d"
                                                    Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                        </Grid>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="1 week" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding SetDnsPresetDurationCommand}" CommandParameter="1w"
                                                    Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                            <Button Grid.Column="2" Content="1 month" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding SetDnsPresetDurationCommand}" CommandParameter="1m"
                                                    Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                            <Button Grid.Column="4" Content="3 months" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding SetDnsPresetDurationCommand}" CommandParameter="3m"
                                                    Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                            <Button Grid.Column="6" Content="1 year" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding SetDnsPresetDurationCommand}" CommandParameter="1y"
                                                    Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                        </Grid>

                                        <!-- Custom Duration Inputs -->
                                        <TextBlock Text="Custom Duration" FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Days" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding DnsCustomDays, UpdateSourceTrigger=PropertyChanged}"
                                                         FontFamily="{DynamicResource FontMono}"
                                                         Style="{StaticResource NumericInputTextBox}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Hours" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding DnsCustomHours, UpdateSourceTrigger=PropertyChanged}"
                                                         FontFamily="{DynamicResource FontMono}"
                                                         Style="{StaticResource NumericInputTextBox}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Minutes" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding DnsCustomMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                         FontFamily="{DynamicResource FontMono}"
                                                         Style="{StaticResource NumericInputTextBox}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="Seconds" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding DnsCustomSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                         FontFamily="{DynamicResource FontMono}"
                                                         Style="{StaticResource NumericInputTextBox}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding DnsCustomDurationSummary}" FontSize="{DynamicResource FontSize12}"
                                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    </StackPanel>

                                    <!-- Challenge info if Challenge Lock -->
                                    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusButton}" Padding="10,6" Margin="0,0,0,12"
                                            Visibility="{Binding IsDnsLockChallenge, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconInfo}"
                                                  Stroke="{DynamicResource TextSecondary}" Width="14" Height="14" Margin="0,2,6,0" VerticalAlignment="Top" />
                                            <TextBlock Text="When locked via typing challenge, unlocking requires typing a randomized 64-character string without errors."
                                                       FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- UNLOCKED STATE ACTION BUTTON -->
                                    <Button Command="{Binding LockDnsCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Right" Padding="20,8" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconLock}"
                                                  Stroke="{DynamicResource TextOnAccent}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Lock DNS" Foreground="{DynamicResource TextOnAccent}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- LOCKED STATE: Status and Unlock Button -->
                                <Grid Visibility="{Binding IsDnsLocked, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconLock}"
                                                  Stroke="{DynamicResource Warning}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="DNS protection is locked" FontSize="{DynamicResource FontSize13}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Warning}" VerticalAlignment="Center" />
                                            <Border CornerRadius="{DynamicResource RadiusButton}" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource SurfaceRaised}"
                                                    BorderBrush="{DynamicResource Warning}" BorderThickness="1"
                                                    Visibility="{Binding DnsLockRemainingFormatted, Converter={StaticResource StringNotEmptyToVis}}">
                                                <TextBlock Text="{Binding DnsLockRemainingFormatted}" FontFamily="{DynamicResource FontMono}"
                                                           FontSize="{DynamicResource FontSize12}" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding DnsLockedUntilLocalFormatted, StringFormat='Locked until: {0}'}"
                                                   FontFamily="{DynamicResource FontMono}"
                                                   FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                                   Margin="0,0,0,4"
                                                   Visibility="{Binding DnsLockedUntilLocalFormatted, Converter={StaticResource StringNotEmptyToVis}}" />

                                        <TextBlock Text="DNS servers can't be changed or turned off until the timer ends. Changes are reverted automatically."
                                                   FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Unlock DNS"
                                            Command="{Binding UnlockDnsCommand}"
                                            IsEnabled="{Binding CanUnlockDns}"
                                            Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Center" Padding="18,8" />
                                </Grid>
                            </StackPanel>

                            <!-- DNS Status Feedback Message -->
                            <TextBlock Text="{Binding DnsMessage}" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource Accent}"
                                       Margin="0,10,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding DnsMessage, Converter={StaticResource StringNotEmptyToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- CATEGORY 5: KEYBOARD SHORTCUTS -->
                    <TextBlock Text="KEYBOARD SHORTCUTS" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                               Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,10" />

                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="20" Margin="0,0,0,24">
                        <StackPanel>
                            <!-- Clickable Expander Header -->
                            <Button Command="{Binding ToggleShortcutsExpandedCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="System Navigation &amp; Productivity Hotkeys" FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" />
                                        <TextBlock Text="Quick reference for global shortcuts across Sankalpa."
                                                   FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1" CornerRadius="{DynamicResource RadiusButton}" Padding="10,6" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ShortcutsToggleText}" FontSize="{DynamicResource FontSize12}"
                                                       Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <Path Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Fill="{DynamicResource Accent}">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="{DynamicResource IconChevronDown}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsShortcutsExpanded}" Value="True">
                                                                <Setter Property="Data" Value="{DynamicResource IconChevronUp}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Collapsible Shortcuts List -->
                            <StackPanel Visibility="{Binding IsShortcutsExpanded, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                                <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,16" />

                                <!-- Ctrl + B -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="New Block Profile" FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" />
                                    <TextBlock Text="Instantly open the new block profile creator dialog."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl + B" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,12" />

                            <!-- Ctrl + S -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Open Settings" FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" />
                                    <TextBlock Text="Toggle between Settings and the main dashboard."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl + S" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,12" />

                            <!-- Ctrl + M -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Meditation Mode" FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" />
                                    <TextBlock Text="Jump directly to the Meditation &amp; Lockdown dashboard."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl + M" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,12" />

                            <!-- Alt + N -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Quick Notes Overlay" FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" />
                                    <TextBlock Text="Summon floating quick notes anywhere while working."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Alt + N" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,12" />

                            <!-- Ctrl + Shift + M -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Start / Stop Meditation" FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" />
                                    <TextBlock Text="Quickly begin or conclude your focus meditation session."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl + Shift + M" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,12" />

                            <!-- Ctrl + Alt + M -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Meditation Settings" FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" />
                                    <TextBlock Text="Open configuration dialog for duration, lockdown, and sounds."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl + Alt + M" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,12" />

                            <!-- Ctrl + Shift + U -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Toggle Soundscape" FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" />
                                    <TextBlock Text="Play, pause, or mute ambient soundscapes."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl + Shift + U" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,12" />

                            <!-- Ctrl + N -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="New Note" FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" />
                                    <TextBlock Text="Open the notes composer to capture ideas or tasks."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl + N" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,12" />

                            <!-- Ctrl + Shift + N -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Toggle Notes Drawer" FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" />
                                    <TextBlock Text="Slide open or close the right-edge notes vault drawer."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl + Shift + N" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,12" />

                            <!-- Esc -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Close Panels &amp; Dialogs" FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3" />
                                    <TextBlock Text="Dismiss open dialogs, settings, or slide-out drawers."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Esc" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. MEDITATION & LOCKDOWN VIEW -->
            <Grid Visibility="{Binding IsMeditationViewActive, Converter={StaticResource BoolToVis}}" Background="{DynamicResource Bg}">
                <!-- Top-Left Expandable Soundscape Pill -->
                <local:SoundscapePillControl DataContext="{Binding Meditation}"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             Margin="24,20,0,0"
                                             Panel.ZIndex="10" />

                <!-- Centered Focus Stage (Completely Pure) -->
                <Grid Margin="24">
                    <Grid.RenderTransform>
                        <TranslateTransform X="0" />
                    </Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Meditation.IsNotesDrawerOpen}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 To="-170"
                                                                 Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 To="0"
                                                                 Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <!-- Subtle Header Badge -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0.7">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconLotus}" Width="14" Height="14"
                                  Stroke="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="MINDFUL FOCUS &amp; LOCKDOWN"
                                       FontFamily="{DynamicResource FontTitle}"
                                       FontSize="{DynamicResource FontSize12}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Large Adaptive Countdown Timer -->
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}"
                                Padding="48,28" Margin="0,0,0,28" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Meditation.CurrentTimerDisplay}"
                                       FontFamily="{DynamicResource FontMono}"
                                       FontSize="{DynamicResource FontSize72}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <!-- Core Action Area -->
                        <StackPanel HorizontalAlignment="Center">
                            <!-- When Idle: Start Emerald Button & Edit... Link -->
                            <StackPanel Visibility="{Binding Meditation.IsIdle, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center">
                                <Button Command="{Binding Meditation.StartMeditationCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="38,12" FontSize="{DynamicResource FontSize15}" FontWeight="SemiBold"
                                        HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlay}" Width="14" Height="14"
                                              Stroke="{DynamicResource TextOnAccent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Start Meditation" Foreground="{DynamicResource TextOnAccent}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding Meditation.OpenEditDialogCommand}"
                                        Content="Edit..."
                                        Style="{StaticResource FlatLockLabelButtonStyle}"
                                        Foreground="{DynamicResource TextSecondary}"
                                        FontSize="{DynamicResource FontSize12}"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        ToolTip="Configure duration, allowed apps, lock rigor, and schedules" />
                            </StackPanel>

                            <!-- When Active: Stop Button (Disabled with Lock badge if Complete Lock) -->
                            <StackPanel Visibility="{Binding Meditation.IsActive, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center">
                                <!-- Complete Lock Active (Exit Disabled) -->
                                <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderStrong}"
                                        BorderThickness="1" CornerRadius="{DynamicResource RadiusButton}" Padding="20,10"
                                        Visibility="{Binding Meditation.IsCompleteLocked, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconLock}" Width="14" Height="14"
                                              Stroke="{DynamicResource TextDisabled}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Complete Lock Active (Exit Disabled)"
                                                   FontWeight="SemiBold" FontSize="{DynamicResource FontSize13}"
                                                   Foreground="{DynamicResource TextDisabled}" />
                                    </StackPanel>
                                </Border>

                                <!-- Challenge / Password / Stop Button (When CanStop is True) -->
                                <Button Command="{Binding Meditation.StopMeditationCommand}"
                                        Style="{StaticResource DangerButton}"
                                        Padding="32,10" FontSize="{DynamicResource FontSize13}" FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding Meditation.CanStop, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconStop}" Width="12" Height="12"
                                              Stroke="{DynamicResource Danger}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Stop Session" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Right-Edge Slide-Out Notes Drawer -->
                <local:NotesDrawerControl x:Name="NotesDrawer"
                                          DataContext="{Binding Meditation}"
                                          IsDrawerOpen="{Binding IsNotesDrawerOpen, Mode=TwoWay}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Stretch"
                                          Panel.ZIndex="20" />
            </Grid>
        </Grid>

        <!-- ROW 3: SLIM STATUS BAR (Calm, Unified Typography) -->
        <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0" Padding="20,7">
            <Grid MaxWidth="920">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Service Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Success}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServiceConnected}" Value="False">
                                        <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="Service: " FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock FontSize="{DynamicResource FontSize12}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Running" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServiceConnected}" Value="False">
                                        <Setter Property="Text" Value="Stopped" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Admin Rights -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Admin Rights: " FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock FontSize="{DynamicResource FontSize12}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Elevated" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServiceElevated}" Value="False">
                                        <Setter Property="Text" Value="Standard" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Website Blocking -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource TextDisabled}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWebsitesBlocking}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HostsStatusDisplay}" Value="Websites: error">
                                        <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding HostsStatusDisplay}" FontSize="{DynamicResource FontSize12}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>

                <!-- Extension Status (Clickable) -->
                <Button Grid.Column="6"
                        Style="{StaticResource StatusBarButtonStyle}"
                        Command="{Binding OpenExtensionDialogCommand}"
                        Cursor="Hand"
                        ToolTip="Click to manage browser extensions and view connection status"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TextDisabled}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExtensionConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExtensionStatusDisplay}" Value="Extension: error">
                                            <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ExtensionStatusDisplay}" FontSize="{DynamicResource FontSize12}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
