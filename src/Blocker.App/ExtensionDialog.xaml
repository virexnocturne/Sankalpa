<Window x:Class="Blocker.App.ExtensionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser Extension Setup"
        Width="680" Height="780"
        MinWidth="580" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextLightBrush}">

    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" Padding="18,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Browser Companion Extension" FontWeight="Bold" FontSize="18"
                           Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,4" />
                <TextBlock Text="Enforces block rules, exceptions, and redirects in Chromium and Firefox browsers."
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                <StackPanel>
                    <!-- SECTION 1: EXTENSION LOCATION & ID -->
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="EXTENSION DETAILS" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />

                            <!-- Folder Path -->
                            <TextBlock Text="Extension Folder:" FontSize="12" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderPathBox" IsReadOnly="True" Height="28"
                                         VerticalContentAlignment="Center" Padding="6,2" />
                                <Button Grid.Column="2" Content="Open folder" Click="OpenFolder_Click"
                                         Style="{StaticResource SecondaryButton}" Padding="12,4" />
                            </Grid>

                            <!-- Extension IDs -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Chromium ID:" FontSize="12" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ExtensionIdBox" IsReadOnly="False" Height="28"
                                                 VerticalContentAlignment="Center" Padding="6,2"
                                                 FontFamily="Consolas, monospace" />
                                        <Button Grid.Column="2" Content="Copy" Click="CopyId_Click"
                                                Style="{StaticResource SecondaryButton}" Padding="8,4" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Firefox Gecko ID:" FontSize="12" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="FirefoxIdBox" IsReadOnly="False" Height="28"
                                                 VerticalContentAlignment="Center" Padding="6,2"
                                                 FontFamily="Consolas, monospace" />
                                        <Button Grid.Column="2" Content="Copy" Click="CopyFirefoxId_Click"
                                                Style="{StaticResource SecondaryButton}" Padding="8,4" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 2: BROWSER STATUS TABLE -->
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="SUPPORTED BROWSERS STATUS" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />

                            <ItemsControl x:Name="BrowsersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfacePillBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                           FontSize="12" Foreground="{DynamicResource TextLightBrush}" VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <!-- Detected Pill -->
                                                    <Border Background="{Binding DetectedBackground}" CornerRadius="10"
                                                            Padding="8,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding DetectedText}" FontSize="11"
                                                                   Foreground="{Binding DetectedForeground}" />
                                                    </Border>

                                                    <!-- Connected Pill -->
                                                    <Border Background="{Binding ConnectedBackground}" CornerRadius="10"
                                                            Padding="8,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding ConnectedText}" FontSize="11"
                                                                   Foreground="{Binding ConnectedForeground}" />
                                                    </Border>

                                                    <!-- Incognito Pill -->
                                                    <Border Background="{Binding IncognitoBackground}" CornerRadius="10"
                                                            Padding="8,2">
                                                        <TextBlock Text="{Binding IncognitoText}" FontSize="11"
                                                                   Foreground="{Binding IncognitoForeground}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 3: REGISTRATION BUTTONS -->
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="NATIVE HOST REGISTRATION" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="Registers the companion communication bridge for all detected browsers."
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="Register extension" Click="RegisterHost_Click"
                                        Padding="16,6" Margin="0,0,10,0" FontWeight="SemiBold" />
                                <Button Content="Unregister" Click="UnregisterHost_Click"
                                        Style="{StaticResource SecondaryButton}" Padding="14,6" />
                            </StackPanel>

                            <TextBlock x:Name="RegistrationStatusTextBlock" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessGreenBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- SECTION 4: INSTRUCTIONS CARD -->
                    <Border Background="{DynamicResource SurfacePillBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="SETUP INSTRUCTIONS" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource AccentBlueBrush}" Margin="0,0,0,8" />

                            <TextBlock Text="Chromium (Chrome, Edge, Brave, etc.):" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBlueBrush}" Margin="0,0,0,3" />
                            <TextBlock Text="1. Open chrome://extensions or edge://extensions and enable 'Developer mode'."
                                       FontSize="12" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="2. Click 'Load unpacked' and select the extension folder above."
                                       FontSize="12" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="3. Click 'Details' and enable 'Allow in Incognito' / 'InPrivate'."
                                       FontSize="12" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Open Edge Extensions" Click="OpenEdgeExtensions_Click"
                                        Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="0,0,8,0" />
                                <Button Content="Open Chrome Extensions" Click="OpenChromeExtensions_Click"
                                        Style="{StaticResource SecondaryButton}" Padding="10,3" />
                            </StackPanel>

                            <TextBlock Text="Mozilla Firefox:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBlueBrush}" Margin="0,0,0,3" />
                            <TextBlock Text="1. Open about:debugging#/runtime/this-firefox in Firefox."
                                       FontSize="12" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="2. Click 'Load Temporary Add-on...' and choose manifest.json in the extension folder above."
                                       FontSize="12" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="3. In about:addons, click Sankalpa Blocker and enable 'Run in Private Windows'."
                                       FontSize="12" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Open Firefox Debugging" Click="OpenFirefoxDebugging_Click"
                                        Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="0,0,8,0" />
                                <Button Content="Open Firefox Add-ons" Click="OpenFirefoxAddons_Click"
                                        Style="{StaticResource SecondaryButton}" Padding="10,3" />
                            </StackPanel>

                            <TextBlock Text="Native Messaging Bridge:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBlueBrush}" Margin="0,0,0,3" />
                            <TextBlock Text="Click 'Register extension' above to register the native messaging host for all installed browsers."
                                       FontSize="12" Foreground="{DynamicResource TextLightBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Close Button -->
            <Grid Grid.Row="2">
                <Button Content="Close" Click="Close_Click" IsCancel="True"
                        HorizontalAlignment="Right" Padding="20,6" MinWidth="80" />
            </Grid>
        </Grid>
    </Border>
</Window>