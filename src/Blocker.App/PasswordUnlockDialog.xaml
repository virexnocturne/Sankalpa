<Window x:Class="Blocker.App.PasswordUnlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blocker.App"
        local:WindowHelper.UseThemeTitleBar="True"
        Title="Password Unlock"
        Width="440" Height="280"
        MinWidth="400" MinHeight="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource TextPrimary}">

    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Text="Enter Password" FontFamily="{DynamicResource FontTitle}"
                       FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />

            <!-- Prompt -->
            <TextBlock x:Name="PromptTextBlock" Grid.Row="1"
                       Text="This profile is locked with a password. Enter your password to continue:"
                       FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16" />

            <!-- Password Box -->
            <PasswordBox x:Name="PasswordInput" Grid.Row="2" Height="34" VerticalContentAlignment="Center"
                         Padding="8,4" Margin="0,0,0,6" KeyDown="PasswordInput_KeyDown" />

            <!-- Error text -->
            <TextBlock x:Name="ErrorTextBlock" Grid.Row="3" Foreground="{DynamicResource Danger}" FontSize="{DynamicResource FontSize12}"
                       Margin="0,0,0,12" Visibility="Collapsed" TextWrapping="Wrap" />

            <!-- Spacer -->
            <Grid Grid.Row="4" />

            <!-- Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="UnlockButton" Content="Unlock" Click="UnlockButton_Click"
                        Padding="20,8" MinWidth="100" Margin="0,0,10,0" IsDefault="True" />
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"
                        Padding="16,8" MinWidth="80" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
