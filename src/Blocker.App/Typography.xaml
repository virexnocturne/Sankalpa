<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ========================================== -->
    <!-- FONT FAMILY TOKENS                         -->
    <!-- ========================================== -->
    <FontFamily x:Key="FontTitle">pack://application:,,,/Sankalpa;component/Fonts/#Familjen Grotesk</FontFamily>
    <FontFamily x:Key="FontBody">pack://application:,,,/Sankalpa;component/Fonts/#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="FontMono">pack://application:,,,/Sankalpa;component/Fonts/#IBM Plex Mono</FontFamily>

    <!-- ========================================== -->
    <!-- FONT SIZE TOKENS (No font size below 12)   -->
    <!-- ========================================== -->
    <sys:Double x:Key="FontSize12">12</sys:Double>
    <sys:Double x:Key="FontSize13">13</sys:Double>
    <sys:Double x:Key="FontSize14">14</sys:Double>
    <sys:Double x:Key="FontSize15">15</sys:Double>
    <sys:Double x:Key="FontSize16">16</sys:Double>
    <sys:Double x:Key="FontSize18">18</sys:Double>
    <sys:Double x:Key="FontSize19">19</sys:Double>
    <sys:Double x:Key="FontSize20">20</sys:Double>
    <sys:Double x:Key="FontSize64">64</sys:Double>
    <sys:Double x:Key="FontSize72">72</sys:Double>
    <sys:Double x:Key="FontSizeTimer">72</sys:Double>

    <!-- Semantic Font Size Aliases -->
    <sys:Double x:Key="FontSizeTitle">18</sys:Double>
    <sys:Double x:Key="FontSizeHeading">16</sys:Double>
    <sys:Double x:Key="FontSizeSubheading">14</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>

    <!-- ========================================== -->
    <!-- CORNER RADIUS TOKENS (Extracted from App)  -->
    <!-- ========================================== -->
    <CornerRadius x:Key="Radius3">3</CornerRadius>
    <CornerRadius x:Key="Radius4">4</CornerRadius>
    <CornerRadius x:Key="Radius5">5</CornerRadius>
    <CornerRadius x:Key="Radius6">6</CornerRadius>
    <CornerRadius x:Key="Radius7">7</CornerRadius>
    <CornerRadius x:Key="Radius8">8</CornerRadius>
    <CornerRadius x:Key="Radius9">9</CornerRadius>
    <CornerRadius x:Key="Radius10">10</CornerRadius>
    <CornerRadius x:Key="Radius12">12</CornerRadius>
    <CornerRadius x:Key="Radius16">16</CornerRadius>
    <CornerRadius x:Key="Radius18">18</CornerRadius>

    <CornerRadius x:Key="RadiusInput">4</CornerRadius>
    <CornerRadius x:Key="RadiusButton">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">16</CornerRadius>

    <!-- ========================================== -->
    <!-- SPACING & PADDING TOKENS (Extracted)       -->
    <!-- ========================================== -->
    <Thickness x:Key="Spacing2">2</Thickness>
    <Thickness x:Key="Spacing4">4</Thickness>
    <Thickness x:Key="Spacing6">6</Thickness>
    <Thickness x:Key="Spacing8">8</Thickness>
    <Thickness x:Key="Spacing10">10</Thickness>
    <Thickness x:Key="Spacing12">12</Thickness>
    <Thickness x:Key="Spacing14">14</Thickness>
    <Thickness x:Key="Spacing16">16</Thickness>
    <Thickness x:Key="Spacing18">18</Thickness>
    <Thickness x:Key="Spacing20">20</Thickness>
    <Thickness x:Key="Spacing24">24</Thickness>

    <Thickness x:Key="ButtonPadding">14,6</Thickness>
    <Thickness x:Key="InputPadding">10,6</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
</ResourceDictionary>
