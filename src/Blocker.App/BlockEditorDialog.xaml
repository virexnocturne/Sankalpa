<Window x:Class="Blocker.App.BlockEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blocker.App"
        local:WindowHelper.UseThemeTitleBar="True"
        Title="Block Editor"
        Width="800" Height="780"
        MinWidth="700" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
        <!-- Toggle button style for day buttons -->
        <Style x:Key="DayToggleButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize12}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="DayBorder" Background="{DynamicResource SurfaceRaised}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="{DynamicResource RadiusButton}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="False" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title & Name Input -->
                <RowDefinition Height="Auto" />
                <!-- Segmented Tabs Navigation -->
                <RowDefinition Height="Auto" />
                <!-- Active Tab Content Area -->
                <RowDefinition Height="*" />
                <!-- Bottom Action Buttons -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ROW 0: Header & Name Input -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock x:Name="DialogHeader" Text="Edit Block" FontFamily="{DynamicResource FontTitle}"
                               FontWeight="SemiBold" FontSize="{DynamicResource FontSizeTitle}"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    <Path x:Name="HeaderLockIcon" Style="{StaticResource Icon}" Data="{StaticResource IconLock}"
                          Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center"
                          Stroke="{DynamicResource Warning}" Visibility="Collapsed" />
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Block Name:" VerticalAlignment="Center" FontWeight="SemiBold"
                               FontSize="{DynamicResource FontSize13}" Margin="0,0,14,0" Foreground="{DynamicResource TextPrimary}" />
                    <TextBox x:Name="NameInput" Grid.Column="1" Height="34" VerticalContentAlignment="Center"
                             Padding="10,6" FontSize="{DynamicResource FontSize13}" />
                </Grid>
                <TextBlock x:Name="NameErrorTextBlock" Foreground="{DynamicResource Danger}" FontSize="{DynamicResource FontSize12}"
                           Margin="96,4,0,0" Visibility="Collapsed" />

                <!-- Locked Banner -->
                <Border x:Name="LockedBanner" Style="{StaticResource LockBannerStyle}"
                        Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource IconLock}"
                              Stroke="{DynamicResource Warning}" Width="16" Height="16" Margin="0,2,10,0"
                              VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Block is locked" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                       Foreground="{DynamicResource Warning}" />
                            <TextBlock Text="You can add more blocked websites or apps. Existing blocked items can't be removed, and exceptions can't be added until the lock expires."
                                       FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ROW 1: SEGMENTED TABS NAVIGATION -->
            <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="3" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <RadioButton x:Name="TabAppsRadio" Grid.Column="0" GroupName="EditorTabs"
                                 Style="{StaticResource SegmentedTabButton}" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconLayoutGrid}"
                                  Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                            <TextBlock x:Name="TabAppsText" Text="Applications" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabWebsitesRadio" Grid.Column="1" GroupName="EditorTabs"
                                 Style="{StaticResource SegmentedTabButton}" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconBan}"
                                  Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                            <TextBlock x:Name="TabWebsitesText" Text="Websites" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabScheduleRadio" Grid.Column="2" GroupName="EditorTabs"
                                 Style="{StaticResource SegmentedTabButton}" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconClock}"
                                  Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                            <TextBlock x:Name="TabScheduleText" Text="Schedule" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabLockRadio" Grid.Column="3" GroupName="EditorTabs"
                                 Style="{StaticResource SegmentedTabButton}" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconShield}"
                                  Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                            <TextBlock x:Name="TabLockText" Text="Lock Protection" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </Border>

            <!-- ROW 2: ACTIVE TAB CONTENT BODY -->
            <ScrollViewer x:Name="EditorScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,8,0,24" Margin="0,0,0,16">
                <StackPanel>
                    <!-- TAB 1: APPLICATIONS -->
                    <Border x:Name="AppsSectionBorder" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusCard}" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="BLOCKED APPLICATIONS" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />

                            <!-- Manual Add Row -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AppInput" Grid.Column="0" Height="32" VerticalContentAlignment="Center"
                                         Padding="8,4" KeyDown="AppInput_KeyDown" ToolTip="Enter process name, e.g. notepad.exe" />
                                <Button Grid.Column="2" Content="+ Add" Click="AddAppInput_Click" Padding="12,4" />
                                <Button Grid.Column="4" Content="Browse..." Click="BrowseApp_Click"
                                        Style="{StaticResource SecondaryButton}" Padding="12,4" />
                                <Button Grid.Column="6" Content="Pick apps..." Click="PickApps_Click"
                                        Style="{StaticResource SecondaryButton}" Padding="14,4" FontWeight="SemiBold" />
                            </Grid>

                            <TextBlock x:Name="AppErrorTextBlock" Foreground="{DynamicResource Danger}" FontSize="{DynamicResource FontSize12}"
                                       Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

                            <!-- Apps List -->
                            <ListBox x:Name="AppsListBox" MinHeight="260" MaxHeight="360"
                                     Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <Button Grid.Column="1" Content="Remove" Click="RemoveApp_Click"
                                                    Style="{StaticResource ListRemoveButton}"
                                                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RemoveButtonVisibility}"
                                                    Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- TAB 2: WEBSITES & EXCEPTIONS -->
                    <Border x:Name="WebsitesSectionBorder" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusCard}" Padding="18" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="WEBSITES &amp; RULES" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />

                            <!-- Checkbox: Block all websites except exceptions -->
                            <CheckBox x:Name="BlockAllWebsitesCheckBox" Content="Block all websites except exceptions list"
                                      FontWeight="SemiBold" Margin="0,0,0,14" Click="BlockAllWebsitesCheckBox_Click" />

                            <!-- Two Columns: Blocked Websites (Left) & Exceptions (Right) -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Blocked Websites -->
                                <Border Grid.Column="0" Background="{DynamicResource SurfaceRaised}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusButton}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="180" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="BLOCKED WEBSITES" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Bulk add (.txt)..." Click="ImportBlockedWebsites_Click"
                                                    Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="{DynamicResource FontSize12}" Height="24"
                                                    ToolTip="Import websites from a text file (.txt)" />
                                        </Grid>

                                        <!-- Add pattern box -->
                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <TextBox x:Name="BlockedPatternInput" Height="30" VerticalContentAlignment="Center"
                                                         Padding="8,4" TextChanged="BlockedPatternInput_TextChanged"
                                                         KeyDown="BlockedPatternInput_KeyDown"
                                                         ToolTip="e.g. example.com, example.com/news, *.example.com, example.com/$" />
                                                <TextBlock x:Name="BlockedPatternPlaceholder" Text="e.g. example.com, *.example.com"
                                                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSize12}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="10,0,0,0" IsHitTestVisible="False" />
                                            </Grid>
                                            <Button Grid.Column="2" Content="+ Add" Click="AddBlockedPattern_Click" Padding="10,4" />
                                        </Grid>

                                        <TextBlock x:Name="BlockedPatternErrorTextBlock" Grid.Row="2" Foreground="{DynamicResource Danger}"
                                                   FontSize="{DynamicResource FontSize12}" Margin="0,0,0,6" Visibility="Collapsed" TextWrapping="Wrap" />

                                        <ListBox x:Name="BlockedPatternsListBox" Grid.Row="3"
                                                 Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                                 AllowDrop="True" Drop="BlockedPatternsListBox_Drop" DragOver="PatternsListBox_DragOver">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextPrimary}" />
                                                        <Button Grid.Column="1" Content="Remove" Click="RemoveBlockedPattern_Click"
                                                                Style="{StaticResource ListRemoveButton}"
                                                                Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RemoveButtonVisibility}"
                                                                Margin="6,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <!-- Column 2: Exceptions (Always Allowed) -->
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceRaised}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusButton}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="180" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="EXCEPTIONS (ALWAYS ALLOWED)" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                            <Button x:Name="ImportExceptionsButton" Grid.Column="1" Content="Bulk add (.txt)..." Click="ImportExceptionWebsites_Click"
                                                    Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="{DynamicResource FontSize12}" Height="24"
                                                    ToolTip="Import allowed website exceptions from a text file (.txt)" />
                                        </Grid>

                                        <!-- Add exception box -->
                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <TextBox x:Name="ExceptionPatternInput" Height="30" VerticalContentAlignment="Center"
                                                         Padding="8,4" TextChanged="ExceptionPatternInput_TextChanged"
                                                         KeyDown="ExceptionPatternInput_KeyDown"
                                                         ToolTip="e.g. example.com/login, api.example.com" />
                                                <TextBlock x:Name="ExceptionPatternPlaceholder" Text="e.g. example.com/login"
                                                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSize12}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="10,0,0,0" IsHitTestVisible="False" />
                                            </Grid>
                                            <Button x:Name="AddExceptionButton" Grid.Column="2" Content="+ Add" Click="AddExceptionPattern_Click" Padding="10,4" />
                                        </Grid>

                                        <!-- Warning banner when locked -->
                                        <StackPanel x:Name="ExceptionLockedHintPanel" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6" Visibility="Collapsed">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconLock}" Width="12" Height="12"
                                                  Stroke="{DynamicResource Warning}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="Exceptions can't be added while a block is locked."
                                                       FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource Warning}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <TextBlock x:Name="ExceptionPatternErrorTextBlock" Grid.Row="2" Foreground="{DynamicResource Danger}"
                                                   FontSize="{DynamicResource FontSize12}" Margin="0,0,0,6" Visibility="Collapsed" TextWrapping="Wrap" />

                                        <ListBox x:Name="ExceptionPatternsListBox" Grid.Row="3"
                                                 Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                                 AllowDrop="True" Drop="ExceptionPatternsListBox_Drop" DragOver="PatternsListBox_DragOver">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextPrimary}" FontWeight="Medium" />
                                                        <Button Grid.Column="1" Content="Remove" Click="RemoveExceptionPattern_Click"
                                                                Style="{StaticResource ListRemoveButton}"
                                                                Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RemoveButtonVisibility}"
                                                                Margin="6,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Live URL Tester -->
                            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusButton}" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Test a URL:" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,12,0" FontSize="{DynamicResource FontSize12}"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBox x:Name="TestUrlInput" Grid.Row="0" Grid.Column="1" Height="30"
                                             VerticalContentAlignment="Center" Padding="8,4"
                                             TextChanged="TestUrlInput_TextChanged"
                                             ToolTip="Enter a URL to test against the current rules, e.g. https://example.com/news" />

                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Result: " FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock x:Name="TestUrlResultTextBlock" Text="Enter a URL above to test"
                                                   FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- System-Wide Blocking Checkbox -->
                            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusButton}" Padding="12">
                                <CheckBox x:Name="SystemWideCheckBox"
                                          Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold"
                                          Checked="SystemWideCheckBox_Changed" Unchecked="SystemWideCheckBox_Changed">
                                    <TextBlock Text="System-wide enforcement (hosts file) — blocks root domains for all desktop apps, not just browsers with extension."
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
                                </CheckBox>
                            </Border>

                            <TextBlock x:Name="ExtensionNoteTextBlock" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- TAB 3: SCHEDULE -->
                    <Border x:Name="ScheduleSectionBorder" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusCard}" Padding="18" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <!-- Complete Lock Schedule Notice -->
                            <Border x:Name="CompleteLockScheduleNoticeBorder" Style="{StaticResource LockBannerStyle}"
                                    Margin="0,0,0,12" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource IconLock}"
                                          Stroke="{DynamicResource Warning}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Schedule is ignored while a complete lock is running."
                                               FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Warning}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Schedule Locked Notice (when block is locked) -->
                            <Border x:Name="ScheduleLockedNoticeBorder" Style="{StaticResource LockBannerStyle}"
                                    Margin="0,0,0,12" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource IconLock}"
                                          Stroke="{DynamicResource Warning}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Schedule rules cannot be added, removed, or modified while this block is locked."
                                               FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Warning}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <StackPanel x:Name="ScheduleContentPanel">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="AUTOMATED SCHEDULE" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="Automatically enables block enforcement during configured time windows."
                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button x:Name="AddScheduleRowButton" Grid.Column="1" Content="+ Add schedule row" Click="AddScheduleRow_Click"
                                        Padding="14,5" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" />
                            </Grid>

                            <!-- Empty schedule note -->
                            <TextBlock x:Name="NoScheduleTextBlock" Text="No schedule rules. When turned On, this profile is blocked 24/7 until turned Off."
                                       FontSize="{DynamicResource FontSize12}" FontStyle="Italic" Foreground="{DynamicResource TextSecondary}" Margin="4,8" />

                            <!-- Schedule Rows List -->
                            <ItemsControl x:Name="ScheduleRowsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceRaised}"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                CornerRadius="{DynamicResource RadiusButton}" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Days Buttons -->
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="16" />
                                                    <!-- Time Range Pickers -->
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <!-- Remove Button -->
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Days of Week Toggle Buttons -->
                                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ToggleButton Content="M" ToolTip="Monday" IsChecked="{Binding Mon}" IsEnabled="{Binding IsEditable}" Style="{StaticResource DayToggleButtonStyle}" />
                                                    <ToggleButton Content="T" ToolTip="Tuesday" IsChecked="{Binding Tue}" IsEnabled="{Binding IsEditable}" Style="{StaticResource DayToggleButtonStyle}" />
                                                    <ToggleButton Content="W" ToolTip="Wednesday" IsChecked="{Binding Wed}" IsEnabled="{Binding IsEditable}" Style="{StaticResource DayToggleButtonStyle}" />
                                                    <ToggleButton Content="T" ToolTip="Thursday" IsChecked="{Binding Thu}" IsEnabled="{Binding IsEditable}" Style="{StaticResource DayToggleButtonStyle}" />
                                                    <ToggleButton Content="F" ToolTip="Friday" IsChecked="{Binding Fri}" IsEnabled="{Binding IsEditable}" Style="{StaticResource DayToggleButtonStyle}" />
                                                    <ToggleButton Content="S" ToolTip="Saturday" IsChecked="{Binding Sat}" IsEnabled="{Binding IsEditable}" Style="{StaticResource DayToggleButtonStyle}" />
                                                    <ToggleButton Content="S" ToolTip="Sunday" IsChecked="{Binding Sun}" IsEnabled="{Binding IsEditable}" Style="{StaticResource DayToggleButtonStyle}" />
                                                </StackPanel>

                                                <!-- Time Range -->
                                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="From:" FontSize="{DynamicResource FontSize12}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBox Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding IsEditable}"
                                                             Style="{StaticResource TimePickerTextBox}" FontSize="{DynamicResource FontSize12}" />
                                                    <Button Content="{Binding FromAmPm}" Click="ToggleFromAmPm_Click"
                                                            IsEnabled="{Binding IsEditable}"
                                                            Visibility="{Binding Is12Hour, Converter={StaticResource BoolToVis}}"
                                                            Style="{StaticResource SecondaryButton}" Padding="6,2" MinWidth="34" Height="28"
                                                            FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" Margin="4,0,0,0"
                                                            ToolTip="Click to toggle AM/PM" />

                                                    <TextBlock Text="To:" FontSize="{DynamicResource FontSize12}" VerticalAlignment="Center" Margin="10,0,6,0"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBox Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding IsEditable}"
                                                             Style="{StaticResource TimePickerTextBox}" FontSize="{DynamicResource FontSize12}" />
                                                    <Button Content="{Binding ToAmPm}" Click="ToggleToAmPm_Click"
                                                            IsEnabled="{Binding IsEditable}"
                                                            Visibility="{Binding Is12Hour, Converter={StaticResource BoolToVis}}"
                                                            Style="{StaticResource SecondaryButton}" Padding="6,2" MinWidth="34" Height="28"
                                                            FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" Margin="4,0,0,0"
                                                            ToolTip="Click to toggle AM/PM" />
                                                </StackPanel>

                                                <!-- Remove Button -->
                                                <Button Grid.Row="0" Grid.Column="4" Content="Remove" Click="RemoveScheduleRow_Click"
                                                        Style="{StaticResource ListRemoveButton}" Padding="8,4" FontSize="{DynamicResource FontSize12}" VerticalAlignment="Center"
                                                        Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RemoveButtonVisibility}" />

                                                <!-- Row Error (if any) -->
                                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding Error}"
                                                           Foreground="{DynamicResource Danger}" FontSize="{DynamicResource FontSize12}" Margin="2,6,0,0"
                                                           Visibility="{Binding Error, Converter={StaticResource StringNotEmptyToVis}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="ScheduleErrorTextBlock" Foreground="{DynamicResource Danger}" FontSize="{DynamicResource FontSize12}"
                                       Margin="0,4,0,0" Visibility="Collapsed" />

                            <!-- DAILY USAGE ALLOWANCE -->
                            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="DAILY USAGE ALLOWANCE" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="Allow a limited amount of access each day before the block locks down."
                                                       FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="AllowanceCheckBox" Grid.Column="1" VerticalAlignment="Center"
                                                  Content="Enable" FontWeight="SemiBold" Checked="AllowanceCheckBox_Changed" Unchecked="AllowanceCheckBox_Changed" />
                                    </Grid>

                                    <StackPanel x:Name="AllowanceConfigPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Daily limit:" FontSize="{DynamicResource FontSize12}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox x:Name="AllowanceMinutesInput" Text="30" Width="64"
                                                         Style="{StaticResource NumericInputTextBox}" FontSize="{DynamicResource FontSize12}" />
                                                <TextBlock Text="min" FontSize="{DynamicResource FontSize12}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                            <!-- Quick Presets -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="BtnAllowance15m" Content="15m" Click="AllowanceQuick_Click" Tag="15" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{DynamicResource FontSize12}" Margin="0,0,4,0" />
                                                <Button x:Name="BtnAllowance30m" Content="30m" Click="AllowanceQuick_Click" Tag="30" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{DynamicResource FontSize12}" Margin="0,0,4,0" />
                                                <Button x:Name="BtnAllowance45m" Content="45m" Click="AllowanceQuick_Click" Tag="45" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{DynamicResource FontSize12}" Margin="0,0,4,0" />
                                                <Button x:Name="BtnAllowance60m" Content="60m" Click="AllowanceQuick_Click" Tag="60" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{DynamicResource FontSize12}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Scope options -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <RadioButton x:Name="rbAllowanceInSchedule" GroupName="AllowanceScope" Content="During scheduled hours only"
                                                         IsChecked="True" FontSize="{DynamicResource FontSize12}" Margin="0,0,16,0" Foreground="{DynamicResource TextPrimary}" />
                                            <RadioButton x:Name="rbAllowance24x7" GroupName="AllowanceScope" Content="24/7 across entire day"
                                                         FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextPrimary}" />
                                        </StackPanel>

                                        <!-- Locked Notice -->
                                        <TextBlock x:Name="AllowanceLockedNoticeTextBlock" Text="Allowance settings cannot be modified while this block is locked."
                                                   FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource Warning}"
                                                   Margin="0,8,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TAB 4: LOCK PROTECTION -->
                    <Border x:Name="LockSectionBorder" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusCard}" Padding="18" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="LOCK PROTECTION" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                            <TextBlock Text="Prevent stopping or disabling this block while it is active."
                                       FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,14" />

                            <StackPanel Margin="0,0,0,8">
                                <RadioButton x:Name="rbUnlocked" GroupName="LockMode" Content="Unlocked (can modify or turn off at any time)"
                                             IsChecked="True" Checked="LockMode_Changed" Margin="0,0,0,10"
                                             FontSize="{DynamicResource FontSize13}" Foreground="{DynamicResource TextPrimary}" />

                                <!-- Timed Lock Option -->
                                <RadioButton x:Name="rbTimedLock" GroupName="LockMode" Content="Complete Lock for a duration (Lock strictly for a set time)"
                                             Checked="LockMode_Changed" Margin="0,0,0,6"
                                             FontSize="{DynamicResource FontSize13}" Foreground="{DynamicResource TextPrimary}" />

                                <!-- Timed Lock Configuration Panel -->
                                <Border x:Name="TimedLockBorder" Background="{DynamicResource SurfaceRaised}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="24,0,0,12" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="LOCK DURATION" FontSize="{DynamicResource FontSize12}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />

                                        <!-- Active Lock Notice Banner (shown when actively locked) -->
                                        <Border x:Name="ActiveLockedNoticeBorder" Style="{StaticResource LockBannerStyle}"
                                                Margin="0,0,0,10" Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource IconLock}"
                                                      Stroke="{DynamicResource Warning}" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Complete Lock is Actively Running" FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}"
                                                               Foreground="{DynamicResource Warning}" Margin="0,0,0,2" />
                                                    <TextBlock Text="This block is currently locked under an active session. The lock duration cannot be modified or lessened until the timer completes."
                                                               FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Preset duration buttons -->
                                        <TextBlock Text="QUICK PRESETS" FontSize="{DynamicResource FontSize12}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="1 hour" Style="{StaticResource SecondaryButton}" Click="QuickLockDuration_Click" Tag="1h" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                            <Button Grid.Column="2" Content="4 hours" Style="{StaticResource SecondaryButton}" Click="QuickLockDuration_Click" Tag="4h" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                            <Button Grid.Column="4" Content="1 day" Style="{StaticResource SecondaryButton}" Click="QuickLockDuration_Click" Tag="1d" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                            <Button Grid.Column="6" Content="3 days" Style="{StaticResource SecondaryButton}" Click="QuickLockDuration_Click" Tag="3d" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="1 week" Style="{StaticResource SecondaryButton}" Click="QuickLockDuration_Click" Tag="1w" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                            <Button Grid.Column="2" Content="1 month" Style="{StaticResource SecondaryButton}" Click="QuickLockDuration_Click" Tag="1m" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                            <Button Grid.Column="4" Content="3 months" Style="{StaticResource SecondaryButton}" Click="QuickLockDuration_Click" Tag="3m" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                            <Button Grid.Column="6" Content="1 year" Style="{StaticResource SecondaryButton}" Click="QuickLockDuration_Click" Tag="1y" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                        </Grid>

                                        <!-- Custom duration input -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Custom duration:" VerticalAlignment="Center" Margin="0,0,10,0"
                                                       FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBox Grid.Column="1" x:Name="TimedLockDurationInput" Text="1" Height="28"
                                                     VerticalContentAlignment="Center" Padding="8,2" FontSize="{DynamicResource FontSize12}"
                                                     Style="{StaticResource NumericInputTextBox}" />
                                            <ComboBox Grid.Column="3" x:Name="TimedLockUnitComboBox" SelectedIndex="2" Height="28" FontSize="{DynamicResource FontSize12}">
                                                <ComboBoxItem Content="Minutes" />
                                                <ComboBoxItem Content="Hours" />
                                                <ComboBoxItem Content="Days" />
                                                <ComboBoxItem Content="Weeks" />
                                                <ComboBoxItem Content="Months (30d)" />
                                                <ComboBoxItem Content="Years (365d)" />
                                            </ComboBox>
                                        </Grid>

                                        <!-- Explanation Banner -->
                                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                                BorderThickness="1" CornerRadius="{DynamicResource RadiusButton}" Padding="12,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconLock}" Width="14" Height="14"
                                                          Stroke="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Complete Lock" FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}"
                                                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="When saved, this block activates immediately and is completely locked for the specified duration. It cannot be stopped, unlocked, or turned off until the timer expires. No schedule needed."
                                                           FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Quick lock button -->
                                        <Button x:Name="StartTimedLockNowButton" Style="{StaticResource PrimaryButton}" Click="StartTimedLockNow_Click"
                                                Margin="0,10,0,0" Padding="16,6" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlay}" Width="12" Height="12"
                                                      Stroke="{DynamicResource TextOnAccent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="Start Complete Lock Now" Foreground="{DynamicResource TextOnAccent}" VerticalAlignment="Center" FontSize="{DynamicResource FontSize12}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Pomodoro Cycles Option -->
                                <RadioButton x:Name="rbPomodoro" GroupName="LockMode" Checked="LockMode_Changed" Margin="0,0,0,6"
                                             Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FontSize13}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconTimer}" Width="14" Height="14"
                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                              Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Pomodoro Cycles (Focus sessions with break intervals)" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <!-- Pomodoro Configuration Panel -->
                                <Border x:Name="PomodoroBorder" Background="{DynamicResource SurfaceRaised}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="24,0,0,12" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Focus Interval -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Focus Interval (mins)" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                                <TextBox x:Name="PomoFocusInput" Text="25" Style="{StaticResource NumericInputTextBox}" FontSize="{DynamicResource FontSize12}" />
                                            </StackPanel>
                                            <!-- Short Break -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Short Break (mins)" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                                <TextBox x:Name="PomoBreakInput" Text="5" Style="{StaticResource NumericInputTextBox}" FontSize="{DynamicResource FontSize12}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Cycles -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Cycles" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                                <TextBox x:Name="PomoCyclesInput" Text="4" Style="{StaticResource NumericInputTextBox}" FontSize="{DynamicResource FontSize12}" />
                                            </StackPanel>
                                            <!-- Long Break -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Long Break (mins)" FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                                <TextBox x:Name="PomoLongBreakInput" Text="15" Style="{StaticResource NumericInputTextBox}" FontSize="{DynamicResource FontSize12}" />
                                            </StackPanel>
                                        </Grid>
                                        <!-- Reward Badge -->
                                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                                BorderThickness="1" CornerRadius="{DynamicResource RadiusButton}" Padding="10,6" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconCheck}" Width="14" Height="14"
                                                      Stroke="{DynamicResource Success}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Rewards: Earns 10m break reward credit upon completing all 4 focus cycles."
                                                           FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource Success}" TextWrapping="Wrap"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <!-- Start Pomodoro Lock button -->
                                        <Button x:Name="StartPomodoroLockNowButton" Style="{StaticResource PrimaryButton}" Click="StartPomodoroLockNow_Click"
                                                Padding="16,6" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlay}" Width="12" Height="12"
                                                      Stroke="{DynamicResource TextOnAccent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="Start Pomodoro Lock Now" Foreground="{DynamicResource TextOnAccent}" VerticalAlignment="Center" FontSize="{DynamicResource FontSize12}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>


                                <RadioButton x:Name="rbTyping" GroupName="LockMode" Content="Typing challenge (requires typing an 80-character text to unlock)"
                                             Checked="LockMode_Changed" Margin="0,0,0,10"
                                             FontSize="{DynamicResource FontSize13}" Foreground="{DynamicResource TextPrimary}" />

                                <RadioButton x:Name="rbPassword" GroupName="LockMode" Content="Password protected"
                                             Checked="LockMode_Changed" Margin="0,0,0,10"
                                             FontSize="{DynamicResource FontSize13}" Foreground="{DynamicResource TextPrimary}" />

                                <RadioButton x:Name="rbDelayedUnlock" GroupName="LockMode" Content="Delayed Unlock (Must wait out an active timer in front of screen to unlock)"
                                             Checked="LockMode_Changed" Margin="0,0,0,10"
                                             FontSize="{DynamicResource FontSize13}" Foreground="{DynamicResource TextPrimary}" />

                                <!-- Delayed Unlock Configuration Panel -->
                                <Border x:Name="DelayedUnlockBorder" Background="{DynamicResource SurfaceRaised}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="24,0,0,12" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="WAIT DURATION PRESETS" FontSize="{DynamicResource FontSize12}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="BtnDelayed15m" Grid.Column="0" Content="15 mins" Style="{StaticResource PrimaryButton}" Click="DelayedUnlockPreset_Click" Tag="15" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                            <Button x:Name="BtnDelayed30m" Grid.Column="2" Content="30 mins" Style="{StaticResource SecondaryButton}" Click="DelayedUnlockPreset_Click" Tag="30" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                            <Button x:Name="BtnDelayed45m" Grid.Column="4" Content="45 mins" Style="{StaticResource SecondaryButton}" Click="DelayedUnlockPreset_Click" Tag="45" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                            <Button x:Name="BtnDelayed60m" Grid.Column="6" Content="1 hour" Style="{StaticResource SecondaryButton}" Click="DelayedUnlockPreset_Click" Tag="60" Padding="0,5" FontSize="{DynamicResource FontSize12}" />
                                        </Grid>

                                        <!-- Explanation Banner -->
                                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                                BorderThickness="1" CornerRadius="{DynamicResource RadiusButton}" Padding="12,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconClock}" Width="14" Height="14"
                                                          Stroke="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Active Presence Required" FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}"
                                                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="When unlocking this block, you must keep the timer open in the foreground for the entire duration. If you close the timer, minimize it, or switch to another app, the unlock will be immediately cancelled."
                                                           FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Password Fields (shown only when Password mode is selected) -->
                            <Border x:Name="PasswordInputsBorder" Background="{DynamicResource SurfaceRaised}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusButton}" Padding="14" Margin="0,4,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <!-- Current Password (if profile already had a password) -->
                                    <StackPanel x:Name="CurrentPasswordPanel" Margin="0,0,0,10" Visibility="Collapsed">
                                        <TextBlock Text="Current Password:" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                        <PasswordBox x:Name="CurrentPasswordBox" Height="30" VerticalContentAlignment="Center" Padding="8,4" />
                                    </StackPanel>

                                    <!-- New Password -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="New Password:" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                            <PasswordBox x:Name="NewPasswordBox" Height="30" VerticalContentAlignment="Center" Padding="8,4" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Confirm Password:" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                            <PasswordBox x:Name="ConfirmPasswordBox" Height="30" VerticalContentAlignment="Center" Padding="8,4" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="LockErrorTextBlock" Foreground="{DynamicResource Danger}" FontSize="{DynamicResource FontSize12}"
                                       Margin="0,8,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ROW 3: BOTTOM ACTIONS -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Delete button (for existing block) -->
                <Button x:Name="DeleteButton" Grid.Column="0" Content="Delete Block"
                        Style="{StaticResource DangerButton}" Click="DeleteButton_Click"
                        Padding="16,8" />

                <!-- Save & Cancel -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Save" Click="SaveButton_Click" Padding="24,8" MinWidth="100"
                            Margin="0,0,10,0" IsDefault="True" />
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"
                            Padding="18,8" MinWidth="90" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Grid>
