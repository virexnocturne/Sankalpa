<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================== -->
    <!-- COLOR TOKENS: WHITE THEME                  -->
    <!-- ========================================== -->
    <Color x:Key="ColorBg">#FFFFFF</Color>
    <Color x:Key="ColorSurface">#F6F6F6</Color>
    <Color x:Key="ColorSurfaceRaised">#EBEBEB</Color>
    <Color x:Key="ColorBorder">#D6D6D6</Color>
    <Color x:Key="ColorBorderStrong">#B8B8B8</Color>
    <Color x:Key="ColorTextPrimary">#111111</Color>
    <Color x:Key="ColorTextSecondary">#525252</Color>
    <Color x:Key="ColorTextDisabled">#8C8C8C</Color>
    <Color x:Key="ColorAccent">#047857</Color>
    <Color x:Key="ColorTextOnAccent">#FFFFFF</Color>
    <Color x:Key="ColorSuccess">#14804A</Color>
    <Color x:Key="ColorWarning">#8A5A00</Color>
    <Color x:Key="ColorDanger">#B3261E</Color>
    <Color x:Key="ColorTextOnDanger">#FFFFFF</Color>

    <!-- Legacy Color Keys for Backwards Compatibility -->
    <Color x:Key="BgDark">#FFFFFF</Color>
    <Color x:Key="BgCard">#F6F6F6</Color>
    <Color x:Key="BgCardHover">#EBEBEB</Color>
    <Color x:Key="BgInput">#FFFFFF</Color>
    <Color x:Key="BorderDark">#D6D6D6</Color>
    <Color x:Key="BorderSubtle">#B8B8B8</Color>
    <Color x:Key="TextLight">#111111</Color>
    <Color x:Key="TextPrimaryColor">#111111</Color>
    <Color x:Key="TextMuted">#525252</Color>
    <Color x:Key="TextDim">#8C8C8C</Color>
    <Color x:Key="AccentBlue">#047857</Color>
    <Color x:Key="AccentBlueHover">#065F46</Color>
    <Color x:Key="SuccessGreen">#14804A</Color>
    <Color x:Key="DangerRed">#B3261E</Color>
    <Color x:Key="WarningAmber">#8A5A00</Color>

    <!-- ========================================== -->
    <!-- BRUSH TOKENS: WHITE THEME                  -->
    <!-- ========================================== -->
    <SolidColorBrush x:Key="Bg" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource ColorBorderStrong}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource ColorTextDisabled}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="TextOnAccent" Color="{StaticResource ColorTextOnAccent}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="TextOnDanger" Color="{StaticResource ColorTextOnDanger}" />

    <!-- Legacy Brush Keys for Backwards Compatibility -->
    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource ColorBorderStrong}" />
    <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource ColorTextDisabled}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="{StaticResource AccentBlueHover}" />
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="{StaticResource AccentBlueHover}" />
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="DangerRedHoverBrush" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="DangerSubtleBgBrush" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="DangerSubtleBorderBrush" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="DangerSubtleTextBrush" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="SurfacePillBrush" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="ButtonSecondaryBgBrush" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="ButtonSecondaryHoverBgBrush" Color="{StaticResource ColorBorderStrong}" />
    <SolidColorBrush x:Key="DangerButtonBgBrush" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="DangerButtonHoverBgBrush" Color="{StaticResource ColorDanger}" />

</ResourceDictionary>
