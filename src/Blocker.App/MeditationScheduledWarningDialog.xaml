<Window x:Class="Blocker.App.MeditationScheduledWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blocker.App"
        local:WindowHelper.UseThemeTitleBar="True"
        Title="Scheduled Meditation Warning"
        Width="490"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource FontBody}">

    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title & Icon -->
                <RowDefinition Height="Auto" />
                <!-- Message -->
                <RowDefinition Height="Auto" />
                <!-- Progress & Timer indicator -->
                <RowDefinition Height="Auto" />
                <!-- Action Buttons -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title & Icon -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="{DynamicResource RadiusPill}" Padding="8" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconLotus}" Width="20" Height="20"
                          Stroke="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Scheduled Meditation Starting"
                               FontFamily="{DynamicResource FontTitle}"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource FontSizeTitle}"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="System lockdown will engage automatically."
                               FontSize="{DynamicResource FontSize12}"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Message Body -->
            <TextBlock x:Name="MessageTextBlock" Grid.Row="1"
                       Text="🧘 Scheduled Meditation session starts in 60s. Wrap up and save your work."
                       FontSize="{DynamicResource FontSize14}" FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimary}"
                       TextWrapping="Wrap" LineHeight="22" Margin="0,4,0,16" />

            <!-- Progress Bar -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <ProgressBar x:Name="CountdownProgressBar" Height="6" Minimum="0" Maximum="60" Value="60"
                             Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceRaised}"
                             BorderThickness="0" />
            </Grid>

            <!-- Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Snooze Button (Allowed once) -->
                <Button Grid.Column="0" x:Name="SnoozeButton"
                        Content="Snooze 5 Minutes"
                        Style="{StaticResource SecondaryButton}"
                        Padding="14,8" HorizontalAlignment="Left"
                        Click="SnoozeButton_Click" ToolTip="Delay session by 5 minutes to finish urgent work (one-time only)" />

                <!-- Begin Now Button -->
                <Button Grid.Column="1" x:Name="BeginNowButton"
                        Content="Begin Now"
                        Style="{StaticResource PrimaryButton}"
                        Padding="20,8" MinWidth="110"
                        Click="BeginNowButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>