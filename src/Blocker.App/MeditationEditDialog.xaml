<Window x:Class="Blocker.App.MeditationEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blocker.App"
        local:WindowHelper.UseThemeTitleBar="True"
        Title="Configure Meditation &amp; Lockdown"
        Width="520"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource FontBody}">

    <Window.Resources>
        <!-- Pill Toggle Style for presets and soundscapes -->
        <Style x:Key="PillRadioButton" TargetType="{x:Type RadioButton}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize12}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="pillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusPill}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Day of Week Pill Toggle -->
        <Style x:Key="DayToggleStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize12}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="dayBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dayBorder" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="dayBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="22,18">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Header -->
                <RowDefinition Height="Auto" />
                <!-- Scrollable Settings -->
                <RowDefinition Height="*" />
                <!-- Footer Buttons -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Configure Meditation &amp; Lockdown"
                           FontFamily="{DynamicResource FontTitle}"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource FontSizeTitle}"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="Customize duration, whitelisted applications, lockdown rigor, and daily schedules."
                           FontSize="{DynamicResource FontSize12}"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16" Padding="0,0,4,0">
                <StackPanel>
                    <!-- SECTION 1: DURATION -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="DURATION" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />
                            <!-- Preset Pills -->
                            <UniformGrid Columns="6" Margin="0,0,0,10">
                                <RadioButton x:Name="Preset15" Content="15m" Style="{StaticResource PillRadioButton}"
                                             GroupName="DurationPreset" Margin="0,0,4,0" Click="Preset_Click" Tag="15" />
                                <RadioButton x:Name="Preset30" Content="30m" Style="{StaticResource PillRadioButton}"
                                             GroupName="DurationPreset" Margin="0,0,4,0" Click="Preset_Click" Tag="30" />
                                <RadioButton x:Name="Preset45" Content="45m" Style="{StaticResource PillRadioButton}"
                                             GroupName="DurationPreset" Margin="0,0,4,0" Click="Preset_Click" Tag="45" />
                                <RadioButton x:Name="Preset1h" Content="1h" Style="{StaticResource PillRadioButton}"
                                             GroupName="DurationPreset" Margin="0,0,4,0" Click="Preset_Click" Tag="60" />
                                <RadioButton x:Name="Preset2h" Content="2h" Style="{StaticResource PillRadioButton}"
                                             GroupName="DurationPreset" Margin="0,0,4,0" Click="Preset_Click" Tag="120" />
                                <RadioButton x:Name="Preset3h" Content="3h" Style="{StaticResource PillRadioButton}"
                                             GroupName="DurationPreset" Margin="0,0,0,0" Click="Preset_Click" Tag="180" />
                            </UniformGrid>

                            <!-- Custom Hours and Minutes Stepper -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Custom:" FontSize="{DynamicResource FontSize12}"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                <!-- Hours Stepper -->
                                <TextBox x:Name="HoursInput" Text="0" Width="44" Height="30"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         Style="{StaticResource NumericInputTextBox}" TextChanged="DurationInput_TextChanged" />
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <Button Content="-" Width="24" Height="30" Style="{StaticResource SecondaryButton}"
                                            Padding="0" Click="DecrementHours_Click" ToolTip="Decrease 1 hour" />
                                    <Button Content="+" Width="24" Height="30" Style="{StaticResource SecondaryButton}"
                                            Padding="0" Margin="3,0,0,0" Click="IncrementHours_Click" ToolTip="Increase 1 hour" />
                                </StackPanel>
                                <TextBlock Text="hr" FontSize="{DynamicResource FontSize12}"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,16,0" />

                                <!-- Minutes Stepper -->
                                <TextBox x:Name="MinutesInput" Text="20" Width="44" Height="30"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         Style="{StaticResource NumericInputTextBox}" TextChanged="DurationInput_TextChanged" />
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <Button Content="-" Width="24" Height="30" Style="{StaticResource SecondaryButton}"
                                            Padding="0" Click="DecrementMinutes_Click" ToolTip="Decrease 1 min" />
                                    <Button Content="+" Width="24" Height="30" Style="{StaticResource SecondaryButton}"
                                            Padding="0" Margin="3,0,0,0" Click="IncrementMinutes_Click" ToolTip="Increase 1 min" />
                                </StackPanel>
                                <TextBlock Text="min" FontSize="{DynamicResource FontSize12}"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 2: ALLOWED APPS -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ALLOWED APPLICATIONS" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />
                            <StackPanel Margin="0,0,0,8">
                                <RadioButton x:Name="RbCompleteLockout" Content="Complete Lockout (0 Apps)"
                                             GroupName="AllowedAppsMode" IsChecked="True"
                                             FontSize="{DynamicResource FontSize12}" Margin="0,0,0,6"
                                             Checked="AllowedAppsMode_Changed" />
                                <RadioButton x:Name="RbAllowApps" Content="Allow Selected Apps"
                                             GroupName="AllowedAppsMode"
                                             FontSize="{DynamicResource FontSize12}"
                                             Checked="AllowedAppsMode_Changed" />
                            </StackPanel>

                            <!-- Whitelisted Apps Panel (Conditional) -->
                            <StackPanel x:Name="AllowedAppsPanel" Visibility="Collapsed" Margin="0,4,0,0">
                                <WrapPanel x:Name="AllowedAppsWrapPanel" Margin="0,0,0,8" />

                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="+ Select Allowed App..." Style="{StaticResource SecondaryButton}"
                                            FontSize="{DynamicResource FontSize12}" Padding="10,5" Click="PickApp_Click" Margin="0,0,8,4" />
                                    <TextBlock x:Name="QuickAppsLabel" Text="Quick:" FontSize="{DynamicResource FontSize12}"
                                               Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center" Margin="6,0,6,4" />
                                    <WrapPanel x:Name="QuickAppsWrapPanel" VerticalAlignment="Center" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 3: LOCK PROTECTION -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="LOCK RIGOR &amp; PROTECTION" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />
                            <RadioButton x:Name="RbLockStrict" Content="Complete Lock (Strict Unbreakable - Exit Disabled)"
                                         GroupName="LockProtection" IsChecked="True"
                                         FontSize="{DynamicResource FontSize12}" Margin="0,0,0,8"
                                         Checked="LockProtectionMode_Changed" />
                            <RadioButton x:Name="RbLockChallenge" Content="Typing Challenge (Type a sentence to exit)"
                                         GroupName="LockProtection"
                                         FontSize="{DynamicResource FontSize12}" Margin="0,0,0,8"
                                         Checked="LockProtectionMode_Changed" />
                            <RadioButton x:Name="RbLockPassword" Content="Password Protection (Enter password to exit)"
                                         GroupName="LockProtection"
                                         FontSize="{DynamicResource FontSize12}"
                                         Checked="LockProtectionMode_Changed" />

                            <!-- Password Protection Panel -->
                            <StackPanel x:Name="PasswordProtectionPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="New Password:" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                        <PasswordBox x:Name="NewPasswordBox" Height="30" VerticalContentAlignment="Center" Padding="8,4" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Confirm Password:" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                        <PasswordBox x:Name="ConfirmPasswordBox" Height="30" VerticalContentAlignment="Center" Padding="8,4" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="PasswordErrorTextBlock" Foreground="{DynamicResource Danger}" FontSize="{DynamicResource FontSize12}"
                                           Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 4: SCHEDULE MODE -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DAILY SCHEDULE" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" x:Name="ScheduleToggle" Content="Run on Daily Schedule"
                                          FontSize="{DynamicResource FontSize12}" Checked="ScheduleToggle_Changed"
                                          Unchecked="ScheduleToggle_Changed" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel x:Name="ScheduleOptionsPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                <!-- Time of Day Range: From [ 15:00 ]  To [ 16:00 ] (24h format) -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="From:" FontSize="{DynamicResource FontSize12}"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" x:Name="ScheduleTimeInput" Text="15:00" Height="30"
                                             Style="{StaticResource TimePickerTextBox}" FontSize="{DynamicResource FontSize12}"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             TextChanged="ScheduleTime_TextChanged" />
                                    <TextBlock Grid.Column="2" Text="To:" FontSize="{DynamicResource FontSize12}"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,8,0" />
                                    <TextBox Grid.Column="3" x:Name="ScheduleEndTimeInput" Text="16:00" Height="30"
                                             Style="{StaticResource TimePickerTextBox}" FontSize="{DynamicResource FontSize12}"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             TextChanged="ScheduleTime_TextChanged" />
                                    <TextBlock Grid.Column="4" Text="(24h format)" FontSize="{DynamicResource FontSize12}"
                                               Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>

                                <!-- Calculated duration helper label -->
                                <TextBlock x:Name="ScheduleDurationLabel" Text="Duration: 1h 00m" FontSize="{DynamicResource FontSize12}"
                                           Foreground="{DynamicResource Accent}" Margin="0,0,0,10" FontWeight="Medium" />

                                <!-- Days of Week -->
                                <TextBlock Text="Repeat Days:" FontSize="{DynamicResource FontSize12}"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                                <UniformGrid Columns="7">
                                    <CheckBox x:Name="DayMon" Content="Mon" Style="{StaticResource DayToggleStyle}" Margin="0,0,2,0" IsChecked="True" />
                                    <CheckBox x:Name="DayTue" Content="Tue" Style="{StaticResource DayToggleStyle}" Margin="0,0,2,0" IsChecked="True" />
                                    <CheckBox x:Name="DayWed" Content="Wed" Style="{StaticResource DayToggleStyle}" Margin="0,0,2,0" IsChecked="True" />
                                    <CheckBox x:Name="DayThu" Content="Thu" Style="{StaticResource DayToggleStyle}" Margin="0,0,2,0" IsChecked="True" />
                                    <CheckBox x:Name="DayFri" Content="Fri" Style="{StaticResource DayToggleStyle}" Margin="0,0,2,0" IsChecked="True" />
                                    <CheckBox x:Name="DaySat" Content="Sat" Style="{StaticResource DayToggleStyle}" Margin="0,0,2,0" />
                                    <CheckBox x:Name="DaySun" Content="Sun" Style="{StaticResource DayToggleStyle}" />
                                </UniformGrid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 5: SOUNDSCAPE SELECTION -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusCard}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="DEFAULT SOUNDSCAPE" FontWeight="Bold" FontSize="{DynamicResource FontSize12}"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <RadioButton x:Name="SoundRain" Content="🌧 Rain" Style="{StaticResource PillRadioButton}"
                                             GroupName="SoundscapePreset" Margin="0,0,6,6" IsChecked="True" Tag="Rain" />
                                <RadioButton x:Name="SoundLibrary" Content="📚 Library" Style="{StaticResource PillRadioButton}"
                                             GroupName="SoundscapePreset" Margin="0,0,6,6" Tag="Library" />
                                <RadioButton x:Name="SoundForest" Content="🌲 Forest" Style="{StaticResource PillRadioButton}"
                                             GroupName="SoundscapePreset" Margin="0,0,6,6" Tag="Forest" />
                                <RadioButton x:Name="SoundBowls" Content="🥣 Singing Bowls" Style="{StaticResource PillRadioButton}"
                                             GroupName="SoundscapePreset" Margin="0,0,6,6" Tag="SingingBowls" />
                                <RadioButton x:Name="SoundMute" Content="🔇 Mute" Style="{StaticResource PillRadioButton}"
                                             GroupName="SoundscapePreset" Margin="0,0,0,6" Tag="None" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- FOOTER BUTTONS -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="16,8" MinWidth="80"
                        Margin="0,0,8,0" Click="CancelButton_Click" />
                <Button Content="Save &amp; Apply" Style="{StaticResource PrimaryButton}" Padding="18,8" MinWidth="110"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>