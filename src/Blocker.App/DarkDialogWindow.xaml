<Window x:Class="Blocker.App.DarkDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blocker"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextLightBrush}">

    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header / Title -->
            <TextBlock x:Name="TitleTextBlock" Grid.Row="0" Text="Title"
                       FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextLightBrush}"
                       Margin="0,0,0,12" />

            <!-- Message Body -->
            <TextBlock x:Name="MessageTextBlock" Grid.Row="1" Text="Message goes here"
                       FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextLightBrush}"
                       LineHeight="20" Margin="0,0,0,20" />

            <!-- Don't show again checkbox -->
            <CheckBox x:Name="DontShowAgainCheckBox" Grid.Row="2" Content="Don't show this warning again"
                      FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                      VerticalAlignment="Center" HorizontalAlignment="Left"
                      Visibility="Collapsed" Margin="0,0,16,0" />

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PrimaryButton" Content="OK" Padding="16,6" MinWidth="80"
                        Click="PrimaryButton_Click" Margin="0,0,8,0" />
                <Button x:Name="SecondaryButton" Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Padding="16,6" MinWidth="80" Click="SecondaryButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
